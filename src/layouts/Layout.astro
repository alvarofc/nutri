---
import '@fontsource/montserrat/latin-400.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-800.css';
import '@fontsource/montserrat/latin-900.css';
import '@fontsource/cormorant/latin-300.css';
import '@fontsource/cormorant/latin-400.css';
import '@fontsource/cormorant/latin-400-italic.css';
import { ViewTransitions } from 'astro:transitions';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/ui';

interface Props {
  description: string;
  title: string;
  image?: string;
  canonicalUrl?: string;
  keywords?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  alternates?: boolean;
}

const { 
  description, 
  title, 
  image = '/images/social-card.jpg', 
  canonicalUrl = Astro.url.pathname,
  keywords = 'nutrition, dietitian, health, wellness, diet',
  type = 'website',
  schema = [],
  alternates = true
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const site = Astro.site || 'https://www.alexandranutri.com';
// Always use the trailing-slash form so canonicals match the sitemap and hreflang URLs
const canonicalURL = new URL(canonicalUrl.endsWith('/') ? canonicalUrl : `${canonicalUrl}/`, site);
const socialImageURL = new URL(image, site);
const siteUrl = new URL('/', site).toString();
const businessId = `${siteUrl}#business`;
const personId = `${siteUrl}#alexandra`;
const isHome = ['/', '/en', '/en/'].includes(Astro.url.pathname);
const esAlternateURL = new URL(getLocalizedPath(Astro.url.pathname, 'es'), site);
const enAlternateURL = new URL(getLocalizedPath(Astro.url.pathname, 'en'), site);
---

<!DOCTYPE html>
<html lang={lang} x-cloak x-data :class="{ 'dark': $store.theme.isDark }">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    
    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Alexandra" />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Hreflang Tags -->
    {alternates && (
      <>
        <link rel="alternate" hreflang="es" href={esAlternateURL} />
        <link rel="alternate" hreflang="en" href={enAlternateURL} />
        <link rel="alternate" hreflang="x-default" href={esAlternateURL} />
      </>
    )}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang} />
    <meta property="og:site_name" content="Alexandra Nutritionist" />
    <meta property="og:article:author" content="Alexandra" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:site" content="@alexandranutri" />
    <meta property="twitter:creator" content="@alexandranutri" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    <meta property="twitter:image:alt" content={title} />
    
    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <ViewTransitions />
    
    <!-- Gentle "arrive" effect: sections fade and rise a little as they come into view -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('rv');
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.classList.add('rv');
        });
        // safety net: if the reveal script never runs, show everything
        setTimeout(function () {
          if (!window.__rvReady) document.documentElement.classList.remove('rv');
        }, 4000);
      })();
    </script>

    <slot name="head" />

    <!-- Structured Data / JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ProfessionalService",
          "@id": businessId,
          "name": lang === 'es' ? "Alexandra Nutricionista" : "Alexandra Nutritionist",
          "url": siteUrl,
          "logo": new URL("/assets/alexandra-2.png", site).toString(),
          "image": socialImageURL.toString(),
          "description": description,
          "telephone": "+34-644-381-191",
          "priceRange": "€€",
          "founder": { "@id": personId },
          "availableLanguage": ["es", "en"],
          "sameAs": [
            "https://www.instagram.com/tunutrialexandra/"
          ],
          "areaServed": [
            {
              "@type": "Country",
              "name": lang === 'es' ? "España" : "Spain"
            }
          ]
        },
        {
          "@type": "Person",
          "@id": personId,
          "name": "Alexandra Ivanova",
          "jobTitle": lang === 'es' ? "Dietista-Nutricionista" : "Dietitian-Nutritionist",
          "identifier": "MAD01541",
          "url": siteUrl,
          "worksFor": { "@id": businessId },
          "knowsAbout": lang === 'es'
            ? ["Salud digestiva", "Microbiota intestinal", "Salud hormonal", "Nutrición antiinflamatoria"]
            : ["Digestive health", "Gut microbiota", "Hormonal health", "Anti-inflammatory nutrition"],
          "sameAs": [
            "https://www.instagram.com/tunutrialexandra/"
          ]
        },
        ...(isHome
          ? [{
              "@type": "WebSite",
              "@id": `${siteUrl}#website`,
              "url": siteUrl,
              "name": "Alexandra Nutri",
              "alternateName": ["Alexandra Nutricionista", "Alexandra Ivanova Nutricionista", "alexandranutri.com"],
              "inLanguage": ["es", "en"],
              "publisher": { "@id": businessId }
            }]
          : []),
        ...schema
      ]
    })}></script>

  </head>
  <body class="bg-brand-cream text-brand-black antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <style is:global>
      /* Film grain over the whole site: turns flat screens into paper */
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: 9999;
        pointer-events: none;
        opacity: 0.4;
        mix-blend-mode: multiply;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.25  0 0 0 0 0.18  0 0 0 0 0.16  0 0 0 0.55 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
      }
      [x-cloak] {
        display: none !important;
      }
      
      /* Titles use the same light serif as the "Nutre tu mente, cuerpo y microbiota" line.
         Small uppercase labels (footer column names, etc.) keep their sans-serif style. */
      h1:not(.uppercase), h2:not(.uppercase), h3:not(.uppercase), h4:not(.uppercase) {
        font-family: 'Cormorant', serif !important;
        font-weight: 400 !important;
        letter-spacing: -0.03em !important;
      }

      /* ---- Shared design tokens: one label style, one lead style, one section header ---- */
      .eyebrow {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #79264D;
      }
      .eyebrow-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: gap 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s;
      }
      .eyebrow-link:hover {
        gap: 0.9rem;
        opacity: 0.8;
      }
      .lead {
        font-family: 'Montserrat', sans-serif;
        font-weight: 300;
        font-size: 1rem;
        line-height: 1.65;
        color: #404040;
      }
      @media (min-width: 640px) {
        .lead {
          font-size: 1.05rem;
        }
      }
      .sec-head {
        margin-bottom: 3.5rem;
      }
      .sec-top {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.75rem;
      }
      .sec-rule {
        height: 1px;
        flex: 1;
        background: rgba(74, 29, 51, 0.2);
        transform-origin: left;
        transition: scale 1.6s cubic-bezier(0.22, 1, 0.36, 1) 0.2s;
      }
      html.rv .sec-head:not(.in) .sec-rule {
        scale: 0 1;
      }
      .sec-title {
        font-size: clamp(2.25rem, 4.4vw, 3.25rem);
        line-height: 1.05;
        color: #4A1D33;
        max-width: 22ch;
      }
      .sec-head .lead {
        margin-top: 1.25rem;
        max-width: 38rem;
      }

      /* "Arrive" effect: blocks fade in and rise a little (about 18px) as they enter the screen */
      html.rv main > :is(section, article):not([data-process]) > div > * {
        opacity: 0;
        translate: 0 18px;
        transition:
          opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
          translate 0.9s cubic-bezier(0.22, 1, 0.36, 1);
      }
      html.rv main > :is(section, article):not([data-process]) > div > *.in {
        opacity: 1;
        translate: 0 0;
      }
      @media (prefers-reduced-motion: reduce) {
        html.rv main > :is(section, article):not([data-process]) > div > * {
          opacity: 1;
          translate: none;
          transition: none;
        }
      }

      /* Smooth scrolling */
      html {
        scroll-behavior: smooth;
      }
      
      /* Selection color */
      ::selection {
        background-color: #79264D;
        color: white;
      }
      
      /* Focus styles */
      *:focus-visible {
        outline: 2px solid #79264D;
        outline-offset: 2px;
      }
      
      /* CTA Gradient Button Animation */
      .cta-gradient-btn {
        background: #79264D;
        transition: all 0.4s ease;
      }
      
      .cta-gradient-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, #79264D 0%, #93405F 25%, #AC798E 40%, #D9A5AE 50%, #AC798E 60%, #93405F 75%, #79264D 100%);
        background-size: 300% 300%;
        opacity: 0;
        transition: opacity 0.3s ease;
        border-radius: inherit;
        animation: gradient-shift 3s ease infinite;
        animation-play-state: paused;
      }
      
      .cta-gradient-btn:hover::before {
        opacity: 1;
        animation-play-state: running;
      }
      
      .cta-gradient-btn:hover {
        transform: scale(1.02);
        box-shadow: 0 4px 20px rgba(121, 38, 77, 0.3);
      }
      
      @keyframes gradient-shift {
        0% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
        100% {
          background-position: 0% 50%;
        }
      }
    </style>
    
    <!-- Alpine.js and plugins from CDN -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.12.3/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.12.3/dist/cdn.min.js"></script>
    
    <script is:inline>
      // Initialize Alpine.js store for theme
      document.addEventListener('alpine:init', () => {
        Alpine.store('theme', {
          isDark: localStorage.getItem('theme') === 'dark' || 
                 (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches),
          toggle() {
            this.isDark = !this.isDark;
            localStorage.setItem('theme', this.isDark ? 'dark' : 'light');
          }
        });
      });
    </script>

    <script is:inline>
      // Remember the visitor's language choice in a cookie so the edge redirect on "/" (vercel.json) respects it
      (function () {
        function saveLang(lang) {
          document.cookie = 'preferredLanguage=' + lang + '; path=/; max-age=31536000; SameSite=Lax';
        }

        // Visitors who chose a language before the cookie existed only have it in storage: carry it over
        try {
          var saved = localStorage.getItem('preferredLanguage');
          if (saved && !/(^|; )preferredLanguage=/.test(document.cookie)) saveLang(saved);
        } catch (error) {
          /* Ignore storage errors */
        }

        document.addEventListener(
          'click',
          function (event) {
            var trigger = event.target instanceof Element && event.target.closest('[data-lang-preference]');
            if (trigger) saveLang(trigger.getAttribute('data-lang-preference'));
          },
          true
        );
      })();
    </script>
    <script>
      function setupArrive() {
        const root = document.documentElement;
        const targets = Array.from(
          document.querySelectorAll<HTMLElement>('main > :is(section, article):not([data-process]) > div > *, main .sec-head')
        );
        window.__rvReady = true;
        if (!('IntersectionObserver' in window)) {
          root.classList.remove('rv');
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              const index = Array.from(el.parentElement?.children ?? []).indexOf(el);
              el.style.transitionDelay = `${Math.min(index, 5) * 110}ms`;
              el.classList.add('in');
              el.addEventListener('transitionend', () => (el.style.transitionDelay = ''), { once: true });
              io.unobserve(el);
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -5% 0px' }
        );
        targets.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', setupArrive);
    </script>
  </body>
</html>
