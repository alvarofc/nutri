---
import PageHeader from '../../components/PageHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = 'es'; // Default to Spanish for the root blog
const t = useTranslations(lang);

const posts = import.meta.glob('./posts/*.md');
let allPosts = await Promise.all(
  Object.entries(posts).map(async ([path, resolver]) => {
    const post = await resolver();
    return { ...post, url: path.replace(/\.md$/, '').replace(/^\./, '/blog') };
  })
);
allPosts.sort((a, b) => (a.frontmatter.order ?? 99) - (b.frontmatter.order ?? 99));
let tags = new Set<string>();
let filteredPosts = allPosts.filter((post) => {
  post.frontmatter.tags.forEach((tag: string) => tags.add(tag));
  return post;
});
---

<Layout title="Blog" description="Blog de Alexandra • Ideas, recomendaciones y consejos que me gusta compartir.">
  <PageHeader
    eyebrow="Ideas y consejos"
    title="Blog"
    lead="Ideas, recomendaciones y consejos que me gusta compartir."
    image="/assets/journal-cabecera-4.webp"
    alt="Cuenco de arándanos sobre una libreta abierta con apuntes"
    width={2000}
    height={1333}
  />

  <section class="relative bg-[#EBDDD6] pt-20 pb-20 sm:pt-28 sm:pb-28">
    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 flex flex-wrap justify-center gap-x-6 gap-y-2">
        {
          [...tags].map((tag) => (
            <span class="eyebrow opacity-70">{tag}</span>
          ))
        }
      </div>

      <!-- List: one article after another -->
      <div class="divide-y divide-brand-accent/15 border-y border-brand-accent/15">
        {
          filteredPosts.map((post) => (
            <article class="group py-8 sm:py-10">
              <div class="flex items-center gap-4 text-xs font-medium tracking-widest text-brand-muted uppercase">
                <time datetime={post.frontmatter.pubDate}>{post.frontmatter.pubDate.substring(0, 10)}</time>
                <span>•</span>
                <span>{post.frontmatter.tags[0]}</span>
              </div>
              <h3 class="mt-3 text-2xl sm:text-3xl font-serif text-brand-black leading-tight group-hover:text-brand-accent transition-colors">
                <a href={post.url}>{post.frontmatter.title}</a>
              </h3>
              <p class="mt-3 text-brand-muted text-base leading-relaxed">{post.frontmatter.description}</p>
              <a href={post.url} class="mt-5 inline-block text-sm font-bold tracking-widest uppercase text-brand-accent border-b border-brand-accent/30 pb-1 hover:border-brand-accent transition-colors">
                Leer Artículo
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
