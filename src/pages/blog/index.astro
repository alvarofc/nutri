---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = 'es'; // Default to Spanish for the root blog
const t = useTranslations(lang);

const posts = import.meta.glob('./posts/*.md');
let allPosts = await Promise.all(
  Object.entries(posts).map(async ([path, resolver]) => {
    const post = await resolver();
    return { ...post, url: path.replace(/\.md$/, '').replace(/^\./, '/blog') };
  })
);
allPosts.sort((a, b) => (a.frontmatter.order ?? 99) - (b.frontmatter.order ?? 99));
let tags = new Set<string>();
let filteredPosts = allPosts.filter((post) => {
  post.frontmatter.tags.forEach((tag: string) => tags.add(tag));
  return post;
});
---

<Layout title="Journal" description="Journal de Alexandra • Ideas, recomendaciones y consejos que me gusta compartir.">
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <!-- Soft lavender to peach gradient background -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#E8E4F0] via-[#F0E6E8] to-[#F5E6DC]"></div>
    
    <!-- Radial gradient for warm center glow -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(248,200,180,0.4)_0%,_transparent_70%)]"></div>
    
    <!-- Soft purple accents on sides -->
    <div class="absolute top-0 left-0 w-1/3 h-full bg-gradient-to-r from-[#DCD4EA]/50 to-transparent"></div>
    <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-[#DCD4EA]/50 to-transparent"></div>

    <div class="relative mx-auto max-w-2xl px-6 lg:max-w-7xl lg:px-8">
      
      <!-- Header -->
      <div class="flex flex-col gap-12 border-b border-brand-accent/10 pb-12 mb-16 lg:flex-row lg:items-end lg:justify-between">
        <div class="flex flex-col gap-6">
          <h1 class="text-6xl font-serif text-brand-black sm:text-7xl md:text-8xl">Journal</h1>
          <p class="max-w-xl text-xl text-brand-muted font-light">
            Ideas, recomendaciones y consejos que me gusta compartir.
          </p>
        </div>
        
        <!-- Tags -->
        <div class="flex flex-wrap gap-4 lg:justify-end">
          {
            [...tags].map((tag) => (
              <span class="px-4 py-2 text-sm uppercase tracking-widest text-brand-black border border-brand-accent/20 rounded-full">
                {tag}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Grid -->
      <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {
          filteredPosts.map((post) => (
            <article class="flex flex-col group">
              <a href={post.url} class="block overflow-hidden rounded-2xl">
                {post.frontmatter.imgUrl ? (
                  <img
                    src={post.frontmatter.imgUrl}
                    alt={post.frontmatter.imgAlt}
                    class="aspect-[16/9] w-full object-cover bg-white/50 transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="aspect-[16/9] w-full bg-gradient-to-br from-[#DCD4EA] via-[#E9DDE6] to-[#F0D9D9] flex items-center justify-center p-8 text-center transition-transform duration-500 group-hover:scale-105">
                    <span class="text-brand-accent/70 text-xs font-medium uppercase tracking-[0.3em]">{post.frontmatter.tags[0]}</span>
                  </div>
                )}
              </a>
              <div class="mt-6 flex flex-col gap-3">
                <div class="flex items-center gap-4 text-xs font-medium tracking-widest text-brand-muted uppercase">
                  <time datetime={post.frontmatter.pubDate}>{post.frontmatter.pubDate.substring(0, 10)}</time>
                  <span>•</span>
                  <span>{post.frontmatter.tags[0]}</span>
                </div>
                <h3 class="text-2xl font-serif text-brand-black leading-tight group-hover:text-brand-accent transition-colors">
                  <a href={post.url}>
                    {post.frontmatter.title}
                  </a>
                </h3>
                <p class="text-brand-muted text-base leading-relaxed">
                  {post.frontmatter.description}
                </p>
                <a
                  href={post.url}
                  class="mt-4 text-sm font-bold tracking-widest uppercase text-brand-accent border-b border-brand-accent/30 pb-1 self-start hover:border-brand-accent transition-colors"
                >
                  Leer Artículo
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
