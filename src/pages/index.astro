---
import About from '../components/home/About.astro';
import Cta from '../components/home/Cta.astro';
import Expertise from '../components/home/Expertise.astro';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/ui';

// English-speaking visitors are sent to /en/ by the edge (see vercel.json), so this page
// is always served as plain Spanish to crawlers and never redirects client-side.
const lang = 'es';
const t = useTranslations(lang);
---

<Layout
  description={t('home.description')}
  title={t('home.page.title')}
>
  <Hero />
  <Services />
  <Expertise />
  <About />
  <Cta />
</Layout>
