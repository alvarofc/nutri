---
import Layout from '../../layouts/Layout.astro';
import BookingSection from '../../components/booking/BookingSection.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t('booking.page.title')}
  description={t('booking.page.description')}
  keywords="book nutrition consultation, schedule appointment, nutrition booking Madrid, dietitian appointment"
  type="website"
  canonicalUrl="/en/booking"
>
  <BookingSection />
</Layout>
