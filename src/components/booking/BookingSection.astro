---
import GoogleBookingEmbed from './GoogleBookingEmbed.astro';
import { INITIAL_ASSESSMENT_PRICE, INITIAL_ASSESSMENT_SCHEDULE_URL } from '../../config/booking';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const en = lang === 'en';

const nextSteps = [t('booking.next.0'), t('booking.next.1'), t('booking.next.2')];
const policy = [t('booking.policy.0'), t('booking.policy.1'), t('booking.policy.2')];
---

<section id="reserva" class="relative scroll-mt-[var(--hdr,88px)] overflow-hidden bg-brand-cream py-14 sm:py-20">
  <div class="mx-auto grid max-w-2xl gap-10 px-4 sm:px-6 lg:max-w-7xl lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-x-14 lg:gap-y-8 lg:px-8">
    <!-- Intro + the session being booked -->
    <header class="flex flex-col gap-5 lg:col-span-5">
      <span class="eyebrow">{t('booking.label')}</span>
      <h1 class="font-serif text-4xl font-light leading-[1.05] tracking-tight text-[#2b2326] sm:text-5xl">
        {t('booking.title')}
      </h1>
      <p class="text-base leading-relaxed text-[#4a3a40] sm:text-lg">{t('booking.subtitle')}</p>

      <!-- Same card as in "Pide cita" -->
      <div class="price-card mt-2 flex flex-col rounded-[1.4rem] px-7 py-6 font-sans text-white sm:px-8">
        <h2 class="text-base font-semibold uppercase leading-snug tracking-[0.1em] sm:text-lg">{t('pricing.assessment.title')}</h2>
        <p class="mt-1.5 text-lg font-normal tracking-[0.06em]">{INITIAL_ASSESSMENT_PRICE}</p>
        <p class="mt-3 text-[1rem] font-normal italic text-white/85">{en ? '75-minute consultation' : 'Consulta de 75 minutos'}</p>
      </div>
    </header>

    <!-- Calendar -->
    <div class="lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1">
      <GoogleBookingEmbed scheduleUrl={INITIAL_ASSESSMENT_SCHEDULE_URL} lang={lang} />
    </div>

    <!-- Details -->
    <div class="flex flex-col gap-8 lg:col-span-5">
      <div class="rounded-[1.4rem] border border-[#79264D]/10 bg-white p-6 shadow-sm sm:p-7">
        <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-[#79264D]">{t('booking.next.title')}</h2>
        <ol role="list" class="mt-5 space-y-4">
          {nextSteps.map((step, i) => (
            <li class="flex gap-4">
              <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-[#79264D] font-sans text-xs font-medium text-white" aria-hidden="true">
                {i + 1}
              </span>
              <span class="font-sans text-[15px] leading-relaxed text-[#3a3a3a]">{step}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="px-1">
        <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-[#79264D]">{t('booking.policy.title')}</h2>
        <ul role="list" class="mt-4 space-y-3 font-sans text-sm leading-relaxed text-[#4a3a40]">
          {policy.map((item) => (
            <li class="flex gap-3"><span class="mt-[0.6em] h-1 w-1 flex-none rounded-full bg-[#79264D]"></span><span>{item}</span></li>
          ))}
        </ul>
      </div>

      <p class="rounded-2xl bg-[#EBDDD6]/60 px-5 py-4 font-sans text-sm leading-relaxed text-[#3a3a3a] shadow-sm">
        {t('booking.patients')}
      </p>
    </div>
  </div>
</section>

<style>
  .price-card {
    background: linear-gradient(145deg, #6A2440, #4A1D33);
    box-shadow: 0 24px 50px -32px rgba(74, 29, 51, 0.7);
  }
</style>
