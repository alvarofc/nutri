---
import PageHeader from '../PageHeader.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<PageHeader
  eyebrow={lang === 'en' ? 'Contact' : 'Contacto'}
  title={lang === 'en' ? 'Get in touch' : 'Ponte en contacto conmigo'}
  lead={lang === 'en' ? 'I would love to hear how I can help you. Choose whichever way suits you best to reach me.' : 'Me encantaría saber cómo te puedo ayudar. Elige la mejor forma de contactarme.'}
  image="/assets/contacto-cabecera-5.webp"
  alt={lang === 'en' ? 'Alexandra looking at her phone' : 'Alexandra mirando su móvil'}
  width={2000}
  height={1333}
/>
