---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import { WHATSAPP_DISPLAY, WHATSAPP_ICON_PATH, whatsappUrl } from '../../config/contact';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const errors = { username: "", email: "", phone: "" };
if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const name = data.get("full-name");
    const email = data.get("email");
    const phone = data.get("phone");
    const password = data.get("password");
    if (typeof name !== "string" || name.length < 1) {
      errors.username += t('contact.form.error.name');
    }
    if (typeof email !== "string" || !email.includes("@")) {
      errors.email += t('contact.form.error.email');
    } 
    if (typeof phone !== "string" || phone.length < 6) {
      errors.phone += t('contact.form.error.phone');
    }
    const hasErrors = Object.values(errors).some(msg => msg)
    if (!hasErrors) {
      const response = await fetch("/api/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, phone, password }),
      }); 
      return Astro.redirect("/");
    }
  } catch (error) {
    if (error instanceof Error) {
      console.error(error.message);
    }
  }
}
---

<section class="relative overflow-hidden py-16 sm:py-24" style="background: #EBDDD6;">
  <!-- Soft leaf shadows falling over the linen, like afternoon light through a window -->
  <div
    class="pointer-events-none absolute -right-[6%] -top-[12%] h-[120%] w-[58%] bg-cover mix-blend-multiply opacity-60"
    style="background-image: url('/assets/sombra-hoja-sala.jpg'); -webkit-mask-image: radial-gradient(ellipse at 72% 38%, #000 18%, transparent 70%); mask-image: radial-gradient(ellipse at 72% 38%, #000 18%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-6xl lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
      <!-- Left: a warm welcome -->
      <div>
        <span class="eyebrow mb-5 block">{lang === 'en' ? 'Shall we talk?' : '¿Hablamos?'}</span>
        <h2 class="font-serif text-3xl font-medium leading-[1.12] text-[#4A1D33] sm:text-4xl lg:text-[2.8rem]">
          {lang === 'en'
            ? 'Contact me so I can assess your case and book your initial assessment'
            : 'Contacta conmigo para que valore tu caso y agende tu valoración inicial'}
        </h2>
        <p class="mt-5 max-w-md font-serif text-[1.35rem] italic leading-snug text-[#5b3a46]">
          {lang === 'en' ? 'A safe space to begin, at your own pace and with no judgement.' : 'Un espacio seguro para empezar, a tu ritmo y sin juicios.'}
        </p>

        <ul class="mt-8 flex flex-col gap-3 font-sans text-[15px] text-[#4a3a40]">
          <li>{lang === 'en' ? 'Response within 24 hours' : 'Respuesta en 24 horas'}</li>
          <li>{lang === 'en' ? 'Your data is safe with me' : 'Tus datos están seguros'}</li>
          <li>{lang === 'en' ? 'No commitment consultation' : 'Consulta sin compromiso'}</li>
        </ul>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={whatsappUrl(lang)}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 rounded-full bg-[#79264D] px-6 py-3 font-sans text-sm font-medium text-white shadow-sm transition-colors hover:bg-[#4A1D33]"
            aria-label={lang === 'en' ? 'Write to me on WhatsApp' : 'Escríbeme por WhatsApp'}
          >
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={WHATSAPP_ICON_PATH}></path></svg>
            <span>WhatsApp</span>
          </a>
          <a
            href={`mailto:${t('contact.email.address')}`}
            class="inline-flex items-center gap-2.5 rounded-full border border-[#79264D]/50 bg-white/60 px-6 py-3 font-sans text-sm font-medium text-[#79264D] transition-colors hover:bg-white"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 7l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z" /></svg>
            <span>{lang === 'en' ? 'Send me an email' : 'Escríbeme un correo'}</span>
          </a>
        </div>
        <p class="mt-4 font-sans text-sm text-[#6a5860]">{WHATSAPP_DISPLAY} · {t('contact.email.address')}</p>
      </div>

      <!-- Right side - Form -->
      <form action="register" method="POST" class="rounded-[1.6rem] border border-white/80 bg-white/80 p-6 shadow-[0_30px_60px_-36px_rgba(74,29,51,0.55)] backdrop-blur-sm sm:p-9">
        <div class="flex flex-col gap-5">
          <!-- Full name input -->
          <div>
            <label for="full-name" class="block text-sm font-medium text-brand-black mb-2">
              {t('contact.form.name')} <span class="text-brand-rose">*</span>
            </label>
            <input
              type="text"
              name="full-name"
              id="full-name"
              autocomplete="name"
              class="block w-full rounded-2xl border-0 bg-white px-4 py-3.5 text-brand-black ring-1 ring-brand-gray/20 placeholder:text-brand-gray transition-all focus:ring-2 focus:ring-brand-accent focus:outline-none hover:ring-brand-accent/50"
              placeholder={t('contact.form.name')}
              required
            />
            {errors.username && <p class="mt-1 text-sm text-brand-rose">{errors.username}</p>}
          </div>

          <!-- Email input -->
          <div>
            <label for="email" class="block text-sm font-medium text-brand-black mb-2">
              {t('contact.form.email')} <span class="text-brand-rose">*</span>
            </label>
            <input
              type="email"
              name="email"
              id="email"
              autocomplete="email"
              class="block w-full rounded-2xl border-0 bg-white px-4 py-3.5 text-brand-black ring-1 ring-brand-gray/20 placeholder:text-brand-gray transition-all focus:ring-2 focus:ring-brand-accent focus:outline-none hover:ring-brand-accent/50"
              placeholder={t('contact.form.email')}
              required
            />
          </div>
          
          <!-- Phone input -->
          <div>
            <label for="phone" class="block text-sm font-medium text-brand-black mb-2">
              {t('contact.form.phone')} <span class="text-brand-rose">*</span>
            </label>
            <input
              type="tel"
              name="phone"
              id="phone"
              autocomplete="tel"
              class="block w-full rounded-2xl border-0 bg-white px-4 py-3.5 text-brand-black ring-1 ring-brand-gray/20 placeholder:text-brand-gray transition-all focus:ring-2 focus:ring-brand-accent focus:outline-none hover:ring-brand-accent/50"
              placeholder={t('contact.form.phone')}
              pattern="^[\+]?[(]?[0-9]{3}[)]?[-\s\.]?[0-9]{3}[-\s\.]?[0-9]{4,6}$"
              required
            />
          </div>

          <!-- Message textarea -->
          <div>
            <label for="message" class="block text-sm font-medium text-brand-black mb-2">
              {t('contact.form.message')} <span class="text-brand-rose">*</span>
            </label>
            <textarea
              name="message"
              id="message"
              rows="4"
              class="block w-full rounded-2xl border-0 bg-white px-4 py-3.5 text-brand-black ring-1 ring-brand-gray/20 placeholder:text-brand-gray transition-all focus:ring-2 focus:ring-brand-accent focus:outline-none hover:ring-brand-accent/50 resize-none"
              placeholder={t('contact.form.message')} 
              required
            ></textarea>
          </div>

          <button
            class="cta-gradient-btn relative mt-2 inline-flex w-full items-center justify-center overflow-hidden rounded-full bg-brand-accent px-6 py-4 text-base font-medium text-white transition-all duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
            type="submit"
          >
            <span class="relative z-10">{t('contact.form.submit')}</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
