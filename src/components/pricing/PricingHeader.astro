---
import PageHeader from '../PageHeader.astro';
import { getLangFromUrl } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';
---

<PageHeader
  eyebrow={es ? 'Servicios' : 'Services'}
  title={es ? 'Descubre cómo puedo ayudarte' : 'Discover how I can help you'}
  lead={es
    ? 'Cada persona tiene una historia y un contexto único. Por eso elaboro un plan de acompañamiento nutricional exclusivamente para ti, teniendo en cuenta tus necesidades y objetivos únicos. Mi forma de trabajar combina ciencia con un acompañamiento cercano, para que dejes de ir a ciegas con tu salud hormonal y tu alimentación.'
    : 'Everyone has a story and a unique context. That is why I create a nutritional support plan exclusively for you, taking into account your unique needs and goals. My way of working combines science with close support, so that you stop going in blind with your hormonal health and your eating.'}
  image="/assets/servicios-cabecera-11.webp"
  alt={es
    ? 'Manos escribiendo en un portátil, con un matcha, arándanos y una libreta sobre la mesa'
    : 'Hands typing on a laptop, with a matcha, blueberries and a notebook on the desk'}
  width={2000}
  height={1333}
/>
