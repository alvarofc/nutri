---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const en = lang === 'en';
const questions = [
  {
    id: 'faq-1',
    title: en ? 'Are the consultations in person or online?' : '¿Las consultas son presenciales u online?',
    answer: en
      ? 'Consultations are held online through Google Meet, and you will receive the access details by email before your consultation.'
      : 'Las consultas se realizan online a través de Google Meet, y recibirás los datos de acceso por correo electrónico antes de la consulta.',
  },
  {
    id: 'faq-2',
    title: en ? 'Can I change or cancel a consultation?' : '¿Puedo modificar o cancelar una consulta?',
    answer: en
      ? 'When you book, that time slot is reserved exclusively for you and requires prior preparation. That is why the fee is non-refundable. If something unexpected comes up, you can change your appointment with at least 24 hours’ notice. With less notice it is not possible to cancel or reschedule (except in cases of force majeure). If you do not attend and do not give notice in time, the consultation is considered to have taken place.'
      : 'Al reservar tu cita, ese horario queda exclusivamente para ti y requiere preparación previa. Por eso, el importe no es reembolsable. Si te surge un imprevisto, puedes cambiar la cita avisando con al menos 24 horas de antelación. Con menos tiempo no es posible cancelar ni reprogramar (salvo fuerza mayor). Si no asistes y no avisas a tiempo, la consulta se considera realizada.',
  },
  {
    id: 'faq-3',
    title: en ? 'Do follow-ups have to take place every month?' : '¿Las revisiones deben realizarse todos los meses?',
    answer: en
      ? 'Not necessarily. You can space out your follow-up consultations according to your progress and needs. However, follow-up appointments can be booked up to 6 months after your last visit. After that period, you will need to book an initial assessment (subject to availability).'
      : 'No necesariamente. Puedes espaciar las consultas de revisión según tu progreso y necesidades. Sin embargo, las citas de seguimiento pueden reservarse hasta 6 meses tras la última visita. Pasado ese plazo, será necesario reservar una valoración inicial (según disponibilidad).',
  },
  {
    id: 'faq-4',
    title: en ? 'Do you work with other health professionals?' : '¿Trabajas en colaboración con otros profesionales de la salud?',
    answer: en
      ? 'Yes, when necessary, we will work together in an integrative way with other professionals (psychologists, endocrinologists, gynaecologists, physiotherapists, etc.). If you already have professionals you trust, we recommend getting in touch so we can work together on your case.'
      : 'Sí, cuando sea necesario, colaboraremos de forma integrativa con otros profesionales (psicólogos, endocrinos, ginecólogos, fisioterapeutas, etc.). Si ya tienes profesionales de confianza, te recomendamos ponernos en contacto para trabajar juntos en tu caso.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: questions.map((question) => ({
    '@type': 'Question',
    name: question.title,
    acceptedAnswer: { '@type': 'Answer', text: question.answer },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="relative py-20 sm:py-28 bg-white">
  <div class="relative mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <!-- Header: label and title above the questions -->
    <div class="sec-head">
      <div class="sec-top">
        <span class="eyebrow">{lang === 'en' ? 'Frequently asked questions' : 'Preguntas frecuentes'}</span>
        <span class="sec-rule" aria-hidden="true"></span>
      </div>
      <h2 class="sec-title !max-w-none lg:whitespace-nowrap">
        {lang === 'en' ? 'Get all your questions answered about my consultation here' : 'Resuelve todas tus dudas sobre mi consulta aquí'}
      </h2>
    </div>

    <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-8">
      <!-- Accordion -->
      <div>
        <dl
          class="space-y-4"
          x-data="{ selected: null, toggle(value) { this.selected = this.selected === value ? null : value } }"
        >
          {
            questions.map((question, index) => (
              <div
                class="bg-brand-cream rounded-2xl overflow-hidden transition-shadow hover:shadow-sm"
                x-data={`{ id: ${index}, get isOpen() { return this.id === this.selected } }`}
              >
                <dt>
                  <button
                    type="button"
                    class="group flex w-full items-center justify-between px-6 py-5 text-left transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-inset rounded-2xl"
                    aria-controls={question.id}
                    x-on:click="toggle(id)"
                    aria-expanded="false"
                    x-bind:aria-expanded="isOpen.toString()"
                  >
                    <span class="font-medium text-brand-black group-hover:text-brand-accent transition-colors">
                      {question.title}
                    </span>
                    <span class="ml-6 flex h-8 w-8 items-center justify-center rounded-full bg-white group-hover:bg-brand-accent/10 transition-colors">
                      <svg
                        class="text-brand-accent h-5 w-5 transform transition duration-200 ease-out"
                        x-bind:class="{ 'rotate-180': isOpen }"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M11.9997 13.1714L16.9495 8.22168L18.3637 9.63589L11.9997 15.9999L5.63574 9.63589L7.04996 8.22168L11.9997 13.1714Z" />
                      </svg>
                    </span>
                  </button>
                </dt>
                <dd 
                  class="px-6 pb-5" 
                  id={question.id} 
                  x-show="isOpen" 
                  x-cloak 
                  x-collapse
                >
                  <p class="text-brand-muted leading-relaxed">
                    {question.answer}
                  </p>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
        <p class="text-brand-muted">
          {lang === 'en' ? "Can't find what you're looking for?" : '¿No encuentras lo que buscas?'}
        </p>
        <a
          href={getLocalizedPath('/contact', lang)}
          class="cta-gradient-btn relative inline-flex items-center justify-center overflow-hidden rounded-full bg-brand-accent px-6 py-3 text-base font-medium text-white transition-all duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
        >
          <span class="relative z-10">{lang === 'en' ? 'Feel free to contact me directly' : 'No dudes en contactarme directamente'}</span>
        </a>
      </div>
    </div>

    <!-- Photo of the desk, with the stickers and the table recoloured to the palette of the site -->
    <div class="mx-auto w-full max-w-sm overflow-hidden rounded-[1.75rem] shadow-[0_30px_60px_-30px_rgba(74,29,51,0.45)] lg:sticky lg:top-28 lg:col-span-4 lg:max-w-none">
      <img
        src="/assets/faq-mesa-3.webp"
        alt={lang === 'en' ? 'Bowl of blueberries on the desk next to a laptop and a book about the microbiome' : 'Cuenco de arándanos sobre la mesa, junto a un portátil y un libro sobre microbiota'}
        class="aspect-[2/3] h-full w-full object-cover"
        width="1000"
        height="1500"
        loading="lazy"
      />
    </div>
    </div>
  </div>
</section>
