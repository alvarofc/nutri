---
import { getLangFromUrl, getLocalizedPath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';

// Titles and texts of the areas (the home page cards link here, one anchor each)
const digestionList = es
  ? ['Síndrome del intestino irritable', 'Dispepsia o malas digestiones', 'Reflujo o acidez', 'Gastritis', 'Helicobacter pylori', 'Sobrecrecimiento bacteriano (SIBO)', 'Sobrecrecimiento intestinal de metanógenos (IMO)', 'Celiaquía y sensibilidad al gluten no celíaca', 'Intolerancias alimentarias: a la lactosa, a la fructosa-sorbitol o a la histamina, entre otras']
  : ['Irritable bowel syndrome (IBS)', 'Dyspepsia or indigestion', 'Reflux or heartburn', 'Gastritis', 'Helicobacter pylori', 'Small intestinal bacterial overgrowth (SIBO)', 'Intestinal methanogen overgrowth (IMO)', 'Coeliac disease and non-coeliac gluten sensitivity', 'Food intolerances: to lactose, to fructose-sorbitol or to histamine, among others'];
const digestion = {
  title: es ? 'Patologías digestivas y alteraciones de la microbiota' : 'Digestive disorders and gut microbiota imbalances',
  text: es
    ? ['El intestino no es solo un órgano digestivo: es un sistema de comunicación, de defensa y de equilibrio. Cuando se altera, todo el cuerpo habla.', 'Tus síntomas tienen una causa. La buscamos juntas y trabajamos desde la raíz. Sin parches.']
    : ['Your gut does far more than digest food: it is a hub of communication, immune defence and balance. When it is out of sync, your whole body feels it.', 'Your symptoms have a cause. Together, we will find it and work on it at the root, with no quick fixes.'],
};

const perimenopause = {
  title: es ? 'Perimenopausia y menopausia' : 'Perimenopause and menopause',
  text: es
    ? ['La alimentación puede marcar la diferencia en cómo se vive la transición a la menopausia. Una alimentación antiinflamatoria (rica en vegetales, semillas, cereales integrales…), con menos carbohidratos refinados y una cantidad adecuada de proteína, ayuda a mantener la energía, la masa muscular y la densidad mineral ósea.']
    : ['What you eat can make a real difference to how you experience the menopause transition. An anti-inflammatory way of eating (rich in vegetables, seeds and whole grains, lower in refined carbohydrates, with enough protein) helps support your energy, muscle mass and bone density.'],
};

const fertility = {
  title: es ? 'Fertilidad, embarazo y posparto' : 'Fertility, pregnancy and postpartum',
  text: es
    ? [
        'Si estás buscando un embarazo, quiero ayudarte a preparar tu cuerpo para esta etapa. Revisaremos tu alimentación, tu salud hormonal y los nutrientes que necesitas, sin que tengas que obsesionarte con hacerlo todo perfecto.',
        'Durante el embarazo y la lactancia, cuidaré de que tanto tú como tu bebé recibáis los nutrientes necesarios, adaptando tu alimentación y la suplementación a cada momento.',
        'Y cuando llegue el posparto, seguiremos cuidando de ti. Porque recuperarte no significa volver cuanto antes a tu cuerpo de antes, sino darle el tiempo y los cuidados que necesita.',
      ]
    : [
        'Trying to conceive? I will help you prepare your body for this next stage. We will look at your diet, your hormonal health and the nutrients you need, without turning it into a quest for perfection.',
        'During pregnancy and breastfeeding, I will make sure you and your baby both get the nutrients you need, adapting your diet and supplements to each stage.',
        'And when your baby arrives, I will still be here to support you. Postpartum recovery is not about getting your old body back as fast as possible; it is about giving yourself the time and care you deserve.',
      ],
};

const metabolic = {
  title: es ? 'Salud metabólica y pérdida de peso' : 'Metabolic health and weight loss',
  text: es
    ? [
        'En consulta quiero que comprendas qué está pasando en tu cuerpo y qué necesita. Trabajaremos tu alimentación y tus hábitos para mejorar tu sensibilidad a la insulina, tu flexibilidad metabólica (la capacidad de tu cuerpo para aprovechar mejor la energía) y cuidar tu masa muscular. Todo con un plan pensado para ti y para tu día a día.',
        'Empezaremos por pequeños cambios que te resulten fáciles de aplicar y que puedas mantener. Porque no se trata de exigirte más, ni intentar encajar una dieta rígida en una agenda que ya está bastante llena, sino de encontrar una forma de cuidarte que te haga sentir bien y que puedas disfrutar.',
        'Al final, la mejor inversión en tu salud está en los hábitos que construyes cada día.',
      ]
    : [
        'In consultation, I want you to understand what is happening in your body and what it needs. We will work on your diet and habits to improve your insulin sensitivity and your metabolic flexibility (your body’s ability to make better use of energy), and to protect your muscle mass. Everything is built around you and your everyday life.',
        'We will start with small changes that are easy to apply and that you can keep up. This is not about demanding more of yourself, or squeezing a rigid diet into an already full schedule; it is about finding a way of looking after yourself that makes you feel good and that you can enjoy.',
        'In the end, the best investment in your health is the habits you build every day.',
      ],
  list: es
    ? ['Pérdida de peso', 'Prediabetes y diabetes', 'Dislipidemia', 'Hipertensión', 'Esteatosis hepática (hígado graso)']
    : ['Weight loss', 'Prediabetes and diabetes', 'Dyslipidaemia', 'Hypertension', 'Fatty liver disease (hepatic steatosis)'],
};

const foodRelationship = {
  title: es ? 'Relación con la comida y trastornos de la conducta alimentaria' : 'Relationship with food and eating disorders',
  text: es
    ? [
        'Puedo acompañarte para adquirir una alimentación más tranquila, consciente y flexible. Una alimentación que realmente disfrutes. Trabajamos tus señales de hambre y saciedad, qué te lleva a comer cuando no tienes hambre y cómo te relacionas con tu cuerpo.',
        'Trabajamos para reconectar con tus señales de hambre y saciedad, comprender qué emociones o situaciones influyen en tu forma de comer y superar los miedos y las normas rígidas en torno a la comida.',
        'El objetivo es que vuelvas a disfrutar de la alimentación, recuperando la confianza en tu cuerpo y avanzando a tu ritmo, desde el respeto y sin juicios.',
      ]
    : [
        'I can support you towards calmer, more mindful and flexible eating, the kind you truly enjoy. We will work on your hunger and fullness cues, what drives you to eat when you are not hungry, and how you relate to your body.',
        'Together we will reconnect with your hunger and fullness signals, understand which emotions or situations shape the way you eat, and let go of fears and rigid food rules.',
        'The goal is for you to enjoy food again, rebuild trust in your body and move forward at your own pace, with respect and without judgement.',
      ],
};

const detail = es
  ? {
      intro: 'Existen diferentes alteraciones hormonales que muchas mujeres sufren hoy en día. La dieta, el ejercicio y los hábitos pueden mejorar mucho el curso y la sintomatología de las mismas. En consulta, adecuaremos la alimentación, la suplementación y realizaremos los cambios de estilo de vida necesarios para solventar los desajustes existentes.',
      items: [
        [
          'Síndrome de ovario poliquístico (SOP)',
          [
            'La insulina es una hormona que ayuda a que el azúcar de la sangre entre en las células para utilizarse como energía. Muchas mujeres con SOP presentan resistencia a la insulina, lo que significa que sus células no responden bien a esta hormona y el cuerpo necesita producir más cantidad. Este exceso de insulina puede alterar el equilibrio hormonal y favorecer síntomas como el acné, el exceso de vello o los ciclos menstruales irregulares.',
            'A través de un plan de nutrición personalizado, podemos mejorar la sensibilidad a la insulina y ayudar a reducir muchos de los síntomas del SOP, gracias a que actuamos directamente sobre la raíz de los mismos.',
          ],
        ],
        [
          'Reglas dolorosas, endometriosis o adenomiosis',
          [
            'El dolor está muy ligado a las prostaglandinas, moléculas inflamatorias que fabrica tu propio cuerpo. Con una alimentación rica en polifenoles, compuestos bioactivos, vitaminas antioxidantes y algunos minerales clave para la relajación de la musculatura uterina, como el magnesio, podemos modular la inflamación, el dolor y el cansancio. Además, ciertos complementos alimenticios tienen evidencia como tratamiento complementario, por lo que se diseña una pauta de suplementación personalizada en función de la paciente.',
          ],
        ],
        [
          'Síndrome premenstrual',
          [
            'No se debe a tener “demasiadas hormonas”, sino a que tu cerebro es más sensible a sus cambios. Estabilizar tu glucosa y asegurar que cubres tus requerimientos nutricionales de calcio, magnesio, zinc y vitamina B6 puede suavizar la irritabilidad, los antojos y la hinchazón.',
          ],
        ],
        [
          'Hipotiroidismo e hipertiroidismo',
          [
            'Tu tiroides necesita yodo, selenio, hierro y vitamina D para fabricar y activar sus hormonas. Además, el café, el calcio o los suplementos de hierro tomados cerca de la levotiroxina reducen su absorción, y muchas veces ese es el motivo de que la dosis “no funcione”. En el hipertiroidismo cuidamos especialmente el músculo y los huesos. Todo adaptado a tus circunstancias únicas.',
          ],
        ],
        [
          'Candidiasis o infecciones de orina de repetición',
          [
            'Cuando las infecciones se repiten, es importante identificar qué factores pueden favorecer su aparición, como los desequilibrios de la microbiota intestinal y vaginal, las alteraciones de la glucosa o las carencias nutricionales.',
            'A través de un plan de nutrición personalizado, basado en una alimentación prebiótica, antiinflamatoria y antioxidante, y suplementación cuando sea necesaria, buscamos favorecer el equilibrio de tu microbiota y reforzar tus defensas naturales, como complemento al tratamiento médico.',
          ],
        ],
      ],
    }
  : {
      intro: 'Many women live with hormonal imbalances, and the right nutrition, exercise and daily habits can make a real difference to their course and symptoms. In consultation, we will tailor your diet and supplements and make the lifestyle changes needed to address the imbalances you are experiencing.',
      items: [
        [
          'Polycystic ovary syndrome (PCOS)',
          [
            'Insulin is the hormone that helps sugar in your blood enter your cells to be used as energy. Many women with PCOS have insulin resistance: their cells do not respond well to insulin, so the body has to produce more of it. This excess insulin can upset your hormonal balance and contribute to symptoms such as acne, excess hair growth and irregular cycles.',
            'With a personalised nutrition plan, we can improve your insulin sensitivity and help ease many PCOS symptoms, because we work directly on their root cause.',
          ],
        ],
        [
          'Painful periods, endometriosis or adenomyosis',
          [
            'Period pain is closely linked to prostaglandins, inflammatory molecules your own body produces. A diet rich in polyphenols, bioactive compounds, antioxidant vitamins and key minerals that help relax the uterine muscle, such as magnesium, can help modulate inflammation, pain and fatigue. Certain supplements also have evidence as a complementary treatment, so I design a personalised supplement plan for each patient.',
          ],
        ],
        [
          'Premenstrual syndrome (PMS)',
          [
            'PMS is not caused by having “too many hormones”, but by your brain being more sensitive to hormonal changes. Stabilising your blood sugar and meeting your needs for calcium, magnesium, zinc and vitamin B6 can ease irritability, cravings and bloating.',
          ],
        ],
        [
          'Hypothyroidism and hyperthyroidism',
          [
            'Your thyroid needs iodine, selenium, iron and vitamin D to make and activate its hormones. Coffee, calcium or iron supplements taken close to levothyroxine can also reduce how well it is absorbed, which is often why a dose “doesn’t seem to work”. With hyperthyroidism, we take extra care of your muscle and bone health. Everything is adapted to your individual circumstances.',
          ],
        ],
        [
          'Recurrent candidiasis or urinary tract infections',
          [
            'When infections keep coming back, it is important to identify the factors that may be contributing, such as imbalances in the gut and vaginal microbiota, blood sugar fluctuations or nutritional deficiencies.',
            'With a personalised nutrition plan built around a prebiotic, anti-inflammatory and antioxidant diet, plus supplements when needed, we aim to support a healthy microbiota and strengthen your natural defences, alongside your medical treatment.',
          ],
        ],
      ],
    };

const bookHref = getLocalizedPath('/booking', lang);
const bookLabel = es ? 'Agenda tu cita de forma fácil' : 'Book your appointment with ease';
// detail.items: 0 PCOS, 1 painful periods / endometriosis, 2 PMS, 3 thyroid, 4 candidiasis
const [pcos, periods, pms, thyroid, candida] = detail.items;

type Row = { id?: string; level: 'area' | 'item'; title: string; paras: string[]; img?: string; alt?: string; photo?: boolean; list?: string[]; stack?: boolean };
const alt = (a: string, b: string) => (es ? a : b);

// Three rooms, each with its own background; the picture alternates sides row after row
const bands: { key: string; head?: { id: string; intro: string }; rows: Row[] }[] = [
  { key: 'a', rows: [
    { id: 'area-digestion', level: 'area', title: digestion.title, paras: digestion.text, img: '/assets/area-digestion.webp', alt: alt('Ilustración del eje intestino-cerebro', 'Illustration of the gut–brain axis'), list: digestionList, stack: true },
    { level: 'item', title: candida[0], paras: candida[1], img: '/assets/area-candidiasis.webp', alt: alt('Ilustración de la microbiota sobre la mucosa', 'Illustration of the microbiota on the mucosa') },
  ] },
  { key: 'b', head: { id: 'area-convives', intro: detail.intro }, rows: [
    { level: 'item', title: pcos[0], paras: pcos[1], img: '/assets/area-sop.webp', alt: alt('Útero y ovarios hechos con flores de papel', 'Uterus and ovaries made of paper flowers') },
    { level: 'item', title: periods[0], paras: periods[1], img: '/assets/area-reglas.webp', alt: alt('Calendario con compresa y días marcados', 'Calendar with a pad and marked days') },
    { level: 'item', title: pms[0], paras: pms[1], img: '/assets/area-premenstrual-2.webp', alt: alt('Ilustración de una mujer con malestar', 'Illustration of a woman feeling unwell') },
    { id: 'area-perimenopausia', level: 'item', title: perimenopause.title, paras: perimenopause.text, img: '/assets/area-menopausia-2.webp', alt: alt('Ilustración de una mujer madura pensativa', 'Illustration of a thoughtful mature woman') },
    { id: 'area-fertilidad', level: 'area', title: fertility.title, paras: fertility.text, img: '/assets/area-embarazo.webp', alt: alt('Ilustración de una mujer embarazada', 'Illustration of a pregnant woman') },
  ] },
  { key: 'c', rows: [
    { level: 'item', title: thyroid[0], paras: thyroid[1], img: '/assets/area-tiroides.webp', alt: alt('Ilustración de una mujer con la mano en el cuello', 'Illustration of a woman with her hand on her neck') },
    { id: 'area-metabolica', level: 'area', title: metabolic.title, paras: metabolic.text, list: metabolic.list },
    { id: 'area-relacion', level: 'area', title: foodRelationship.title, paras: foodRelationship.text, img: '/assets/area-relacion.webp', alt: alt('Ilustración de una pareja comiendo bocadillos', 'Illustration of a couple eating sandwiches') },
  ] },
];
let n = 0; // alternation counter across the whole section
---

<section id="areas-de-especializacion" class="areas scroll-mt-[var(--hdr,88px)]">
  <!-- Heading of part 1 (same pattern as parts 2 and 3) -->
  <div class="a-top bg-a">
    <div class="sec-top mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <span class="eyebrow">{es ? 'Nutrición clínica e integrativa' : 'Clinical and integrative nutrition'}</span>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    <h2 class="px-4 pt-0 text-center font-serif text-3xl leading-[1.05] text-brand-black sm:text-4xl lg:text-[2.9rem]">
      {es ? 'Áreas de especialización' : 'Areas of expertise'}
    </h2>
  </div>

  {bands.map((band) => (
    <div class={`band bg-${band.key}`}>
      <div class="wrap">
        {band.head && (
          <div id={band.head.id} class="g-head">
            <p>{band.head.intro}</p>
          </div>
        )}
        {band.rows.map((row) => {
          const flip = n % 2 === 1;
          n++;
          return (
            <article id={row.id} class={`row ${flip ? 'rev' : ''} ${row.list ? 'with-list' : ''} ${row.stack ? 'stack' : ''}`}>
              {row.stack ? (
                /* Two columns: text with the picture under it | list */
                <>
                  <div class="col">
                    <div class="body">
                      <h3 class={`t ${row.level}`}>{row.title}</h3>
                      {row.paras.map((p) => (<p>{p}</p>))}
                    </div>
                    <figure class="art art-sm"><img src={row.img} alt={row.alt} loading="lazy" /></figure>
                  </div>
                  <ul class="mini">
                    {row.list!.map((item) => (
                      item.startsWith('raw:')
                        ? <li class="eyebrow raw">{item.slice(4)}</li>
                        : <li class="eyebrow">{item}</li>
                    ))}
                  </ul>
                </>
              ) : (
                <>
                  <div class="side">
                    {(row.img || !row.list) && (
                      <figure class={`art ${row.photo ? 'art-photo' : ''} ${row.img ? '' : 'art-ph'}`} aria-hidden={row.img ? undefined : 'true'}>
                        {row.img
                          ? <img src={row.img} alt={row.alt} loading="lazy" />
                          : <span>{es ? 'Foto' : 'Photo'}</span>}
                      </figure>
                    )}
                    {row.list && (
                      <ul class="mini">
                        {row.list.map((item) => (
                          item.startsWith('raw:')
                            ? <li class="eyebrow raw">{item.slice(4)}</li>
                            : <li class="eyebrow">{item}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                  <div class="body">
                    <h3 class={`t ${row.level}`}>{row.title}</h3>
                    {row.paras.map((p) => (<p>{p}</p>))}
                  </div>
                </>
              )}
            </article>
          );
        })}
      </div>
    </div>
  ))}

  <div class="cta bg-c"><a href={bookHref}>{bookLabel}</a></div>
</section>

<style>
  .areas { background: #F7F1EA; }
  .bg-a { background: #F7F1EA; }
  .bg-b { background: #EADBD3; }
  .bg-c { background: #F4EADF; }
  .a-top { padding: 3.5rem 0 0; }
  @media (min-width: 640px) { .a-top { padding-top: 5rem; } }
  .a-top .sec-top { margin-bottom: 0.4rem; }
  .band { padding: 1.5rem 0; }
  .wrap { margin-inline: auto; max-width: 66rem; padding-inline: 1rem; }
  @media (min-width: 640px) { .wrap { padding-inline: 1.5rem; } }
  @media (min-width: 1024px) { .wrap { padding-inline: 2rem; } }

  .g-head { padding: 3rem 0 0.5rem; scroll-margin-top: 7rem; }
  .g-head p { font-size: 1rem; line-height: 1.75; color: #3f3f3f; text-align: justify; hyphens: none; }

  /* One row per point: picture and text, alternating sides */
  .row { display: grid; gap: 1.2rem; align-items: center; scroll-margin-top: 7rem; padding: 2.4rem 0; }
  @media (min-width: 900px) {
    .row { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 4.5rem; padding: 3.2rem 0; }
    .row.rev { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
    .row.rev .side { order: 2; }
  }

  /* A short list of conditions under the picture, divided by thin lines */
  .mini { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(74, 29, 51, 0.22); }
  .mini li { padding: 1.05rem 0; border-bottom: 1px solid rgba(74, 29, 51, 0.22); line-height: 1.55; }
  .row.with-list { align-items: start; }
  @media (min-width: 900px) { .row.with-list:not(.stack) { align-items: center; } .row.with-list:not(.stack) .side { padding-top: 0.8rem; } }
  .row.with-list .body { padding-top: 0; }
  .row.with-list .side .art img { max-height: 9.5rem; margin-inline: auto; width: auto; }
  .row.with-list .side .mini { margin-top: 0; }
  /* Digestive row: text with the picture underneath on the left, list on the right */
  .stack .art-sm { margin: 1.8rem auto 0; max-width: 19rem; }
  .stack .body { padding-top: 0; }
  @media (max-width: 899px) { .stack .mini { margin-top: 1.6rem; } }
  @media (min-width: 900px) { .row.stack { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); } }
  .art { margin: 0; }
  .art img { display: block; width: 100%; max-height: 26rem; object-fit: contain; }
  .art.art-photo img { aspect-ratio: 4 / 3; max-height: none; object-fit: cover; border-radius: 1.4rem; box-shadow: 0 30px 60px -38px rgba(74, 29, 51, 0.45); }
  /* Placeholder where a picture will go */
  .art.art-ph { display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3; border: 1.5px dashed rgba(121, 38, 77, 0.35); border-radius: 1.4rem; background: rgba(255, 255, 255, 0.35); font-family: 'Montserrat', sans-serif; font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(121, 38, 77, 0.55); }

  /* One title style everywhere: Cormorant. The areas keep the plum colour, the points inside are dark */
  .t { font-family: 'Cormorant', serif; font-weight: 500; font-size: 1.7rem; line-height: 1.12; margin-bottom: 0.7rem; }
  @media (min-width: 900px) { .t { font-size: 1.95rem; } }
  .t.area { color: #79264D; }
  .t.item { color: #79264D; }
  .body p { margin-top: 0.8rem; max-width: 36rem; text-align: justify; hyphens: none; font-size: 1rem; line-height: 1.75; color: #3f3f3f; }

  .cta { padding: 2rem 1rem 5rem; text-align: center; }
  .cta a { display: inline-flex; border-radius: 9999px; background: #79264D; padding: 0.95rem 2.4rem; font-family: 'Montserrat', sans-serif; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #fff; transition: background 0.3s; }
  .cta a:hover { background: #4A1D33; }

  /* Arriving from the home page: a soft highlight on the area you came for */
  .row:target .body, .g-head:target { animation: area-flash 2.4s ease-out; border-radius: 0.6rem; }
  @keyframes area-flash { 0% { box-shadow: 0 0 0 0.7rem rgba(121, 38, 77, 0.14); } 100% { box-shadow: 0 0 0 0.7rem rgba(121, 38, 77, 0); } }
  @media (prefers-reduced-motion: reduce) { .row:target .body, .g-head:target { animation: none; } }
</style>

<script>
  // Coming from a card on the home page: make sure the page lands on the area you chose,
  // once the layout has settled (the header is fixed, the anchors already leave room for it).
  const goToArea = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const el = document.getElementById(id);
    if (!el || !el.closest('#areas-de-especializacion')) return;
    [120, 500, 1100].forEach((ms) => window.setTimeout(() => {
      if (Math.abs(el.getBoundingClientRect().top - 112) > 8) el.scrollIntoView({ block: 'start' });
    }, ms));
  };
  document.addEventListener('astro:page-load', goToArea);
  goToArea();
</script>
