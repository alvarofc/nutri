---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="pt-20 sm:pt-28 pb-12 sm:pb-16 bg-brand-cream">
  <div class="mx-auto max-w-2xl px-4 text-center sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col items-center gap-6">
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-[clamp(2.25rem,4.6vw,3.75rem)] text-brand-black leading-tight tracking-tight max-w-3xl lg:max-w-none lg:whitespace-nowrap">
        {t('pricing.title')}
      </h1>
    </div>
  </div>
</section>
