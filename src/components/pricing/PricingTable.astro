---
import { ArrowRight, Lock } from 'lucide-astro';
import { INITIAL_ASSESSMENT_PRICE } from '../../config/booking';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Only the initial assessment is bookable from the site; the rest are booked
// through private links sent after the first consultation.
const groups = [
  {
    label: t('pricing.sections.initial'),
    items: [
      {
        title: t('pricing.assessment.title'),
        duration: t('pricing.assessment.duration'),
        description: t('pricing.assessment.description'),
        price: INITIAL_ASSESSMENT_PRICE,
        bookable: true,
      },
      {
        title: t('pricing.plan.title'),
        duration: t('pricing.plan.duration'),
        description: t('pricing.plan.description'),
        price: '70 €',
      },
    ],
  },
  {
    label: t('pricing.sections.continuity'),
    items: [
      {
        title: t('pricing.followup.title'),
        duration: t('pricing.followup.duration'),
        description: t('pricing.followup.description'),
        price: '65 €',
      },
      {
        title: t('pricing.bundle.title'),
        duration: `${t('pricing.bundle.duration')} · ${t('pricing.bundle.saving')}`,
        description: t('pricing.bundle.description'),
        price: '240 €',
      },
    ],
  },
];
---

<section class="relative py-16 sm:py-24 overflow-hidden">
  <!-- Soft lavender to peach gradient background (same as "¿Cómo trabajo?") -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#EBDDD6] via-[#E5D3C8] to-[#EBDDD6]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(248,200,180,0.5)_0%,_transparent_70%)]"></div>
  <div class="absolute top-0 left-0 w-1/3 h-full bg-gradient-to-r from-[#E3CFC5]/60 to-transparent"></div>
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-[#E3CFC5]/60 to-transparent"></div>

  <div class="relative mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-6xl lg:px-8">
    <div class="grid gap-6 lg:grid-cols-2">
      {
        groups.map((group) => (
          <div class="flex flex-col rounded-2xl bg-white/80 backdrop-blur-sm border border-white/60 shadow-sm p-8 sm:p-10">
            <h2 class="text-xs font-medium uppercase tracking-widest text-brand-accent">{group.label}</h2>
            <ul role="list" class="divide-y divide-brand-gray/20">
              {group.items.map((item) => (
                <li class="flex flex-col py-8 last:pb-0">
                  <div class="flex items-baseline justify-between gap-6">
                    <h3 class="font-serif text-2xl text-brand-black">{item.title}</h3>
                    <p class="whitespace-nowrap font-serif text-3xl text-brand-accent">{item.price}</p>
                  </div>
                  <p class="mt-1 text-sm text-brand-gray">{item.duration}</p>
                  <p class="mt-4 leading-relaxed text-brand-charcoal">{item.description}</p>
                  {item.bookable ? (
                    <a
                      href={getLocalizedPath('/booking', lang)}
                      class="group mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-brand-accent px-6 py-3 text-base font-medium text-white transition hover:bg-brand-accent/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
                    >
                      {t('pricing.action.book')}
                      <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                    </a>
                  ) : (
                    <p class="mt-6 inline-flex items-center gap-2 text-sm text-brand-gray">
                      <Lock class="h-3.5 w-3.5 flex-shrink-0" aria-hidden="true" />
                      {t('pricing.private')}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mx-auto mt-12 max-w-3xl text-center text-sm leading-relaxed text-brand-gray">
      {t('pricing.policy')}
    </p>
  </div>
</section>
