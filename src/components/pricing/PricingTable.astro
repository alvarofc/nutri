---
import { Lock } from 'lucide-astro';
import { INITIAL_ASSESSMENT_PRICE } from '../../config/booking';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Only the initial assessment is bookable from the site; the rest are booked
// through private links sent after the first consultation.
const groups = [
  {
    label: t('pricing.sections.initial'),
    items: [
      {
        title: t('pricing.assessment.title'),
        meta: t('pricing.assessment.duration'),
        price: INITIAL_ASSESSMENT_PRICE,
        bookable: true,
      },
      {
        title: lang === 'en' ? 'Personalised plan delivery session' : 'Sesión de entrega del plan personalizado',
        meta: t('pricing.plan.duration'),
        price: '70 €',
      },
    ],
  },
  {
    label: t('pricing.sections.continuity'),
    items: [
      {
        title: lang === 'en' ? 'Follow-up session' : 'Sesión de seguimiento',
        meta: t('pricing.followup.duration'),
        price: '65 €',
      },
      {
        title: lang === 'en' ? 'Bundle of 4 follow-ups' : 'Bono de 4 seguimientos',
        meta: `${t('pricing.bundle.duration')} · ${t('pricing.bundle.saving')}`,
        price: '240 €',
      },
    ],
  },
];
---

<section class="relative overflow-hidden bg-[#EBDDD6] py-16 sm:py-24">
  <!-- Same colour as "Paso a paso / Cómo te acompaño" on the home page (#EBDDD6) -->

  <div class="relative mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <!-- Label above the prices, same format as "En qué consisten las sesiones" -->
    <div class="sec-top">
      <span class="eyebrow">{lang === 'en' ? 'Rates' : 'Tarifas'}</span>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>

    <div class="mx-auto grid gap-6 lg:max-w-5xl lg:grid-cols-2">
      {
        groups.map((group) => (
          <div class="flex flex-col rounded-[2rem] border border-brand-accent/10 bg-[#FFFCFA] p-6 shadow-[0_24px_50px_-30px_rgba(74,29,51,0.45)] sm:p-8">
            <h2 class="border-b border-brand-accent/20 pb-4 text-center font-sans text-lg font-semibold uppercase tracking-[0.18em] text-brand-accent">
              {group.label}
            </h2>
            <ul role="list" class="mt-4 flex flex-1 flex-col gap-3">
              {group.items.map((item) => (
                <li class="rounded-2xl bg-[#F8F1EC] px-4 py-4">
                  <h3 class="whitespace-nowrap font-serif text-xl leading-tight text-brand-black sm:text-2xl">{item.title}</h3>
                  <div class="mt-2 flex items-end justify-between gap-4">
                    <p class="text-sm text-brand-gray">
                      {item.meta}
                      {item.extra && <span class="ml-1 font-medium text-brand-accent">· {item.extra}</span>}
                    </p>
                    <p class="whitespace-nowrap font-serif text-4xl leading-none text-brand-accent sm:text-[2.6rem]">{item.price}</p>
                  </div>
                  {item.bookable && (
                    <a
                      href={getLocalizedPath('/booking', lang)}
                      class="cta-gradient-btn relative mt-4 flex w-full items-center justify-center overflow-hidden rounded-full bg-brand-accent px-6 py-3 text-base font-medium text-white transition-all duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
                    >
                      <span class="relative z-10">{t('pricing.action.book')}</span>
                    </a>
                  )}
                </li>
              ))}
            </ul>
            {group.label === t('pricing.sections.continuity') && (
              <p class="mt-4 flex items-center justify-center gap-2 text-center text-sm text-brand-gray">
                <Lock class="h-3.5 w-3.5 flex-shrink-0" aria-hidden="true" />
                {t('pricing.private')}
              </p>
            )}
          </div>
        ))
      }
    </div>

    <p class="mx-auto mt-8 max-w-3xl text-center text-xs leading-relaxed text-brand-gray">
      {t('pricing.policy')}
    </p>
  </div>
</section>
