---
import { Lock } from 'lucide-astro';
import { INITIAL_ASSESSMENT_PRICE } from '../../config/booking';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const en = lang === 'en';

// Only the initial assessment is bookable from the site; the rest are booked
// through private links sent after the first consultation.
const groups = [
  {
    kicker: en ? 'Initial consultation' : 'Consulta inicial',
    heading: en ? 'It’s my first time' : 'Es mi primera vez',
    items: [
      {
        title: en ? 'Initial assessment' : 'Valoración inicial',
        price: INITIAL_ASSESSMENT_PRICE,
        lines: [en ? '75-minute consultation' : 'Consulta de 75 minutos'],
        bookable: true,
      },
      {
        title: en ? 'Personalised plan delivery session' : 'Sesión de entrega del plan personalizado',
        price: '70 €',
        lines: [en ? '60-minute consultation' : 'Consulta de 60 minutos'],
      },
    ],
  },
  {
    kicker: en ? 'Follow-up consultation' : 'Consulta de revisión',
    heading: en ? 'I’m already a patient' : 'Ya soy paciente',
    private: true,
    items: [
      {
        title: en ? 'Follow-up session' : 'Sesión de seguimiento',
        price: '65 €',
        lines: [en ? '45-minute consultation' : 'Consulta de 45 minutos'],
      },
      {
        title: en ? 'Bundle of 4 follow-ups' : 'Bono de 4 seguimientos',
        price: '240 €',
        lines: en ? ['4 consultations of 45 minutes', '60 € per consultation'] : ['4 consultas de 45 minutos', '60 € por consulta'],
      },
    ],
  },
];
---

<section id="pide-cita" class="pc-section relative flex scroll-mt-[var(--hdr,88px)] flex-col justify-center overflow-hidden bg-[#EBDDD6] py-12 sm:py-14 lg:min-h-[calc(100svh-5.5rem)]">
  <div class="relative mx-auto w-full max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <!-- Label above the prices, same format as "En qué consisten las sesiones" -->
    <div class="sec-top">
      <span class="eyebrow">{en ? 'Book an appointment' : 'Pide cita'}</span>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>

    <!-- One shared grid: the four cards have exactly the same size -->
    <div class="pc-grid mx-auto grid max-w-6xl grid-cols-1 gap-x-8 gap-y-4 xl:gap-x-12">
      {
        groups.map((group, gi) => (
          <>
            <header class={`pc-head text-center ${gi > 0 ? 'mt-10 lg:mt-0' : ''}`} style={`--c:${gi + 1}`}>
              <p class="font-sans text-sm font-light uppercase tracking-[0.22em] text-[#3a3a3a] sm:text-base">{group.kicker}</p>
              <h2 class="mt-1 font-serif text-4xl font-light leading-tight text-[#2b2326] lg:text-[2.6rem]">{group.heading}</h2>
            </header>
            <ul role="list" class="contents">
              {group.items.map((item, ii) => (
                <li class="price-card flex flex-col rounded-[1.4rem] px-7 py-5 font-sans text-white sm:px-8" style={`--c:${gi + 1}; --r:${ii + 2}`}>
                  <h3 class="text-base font-semibold uppercase leading-snug tracking-[0.1em] sm:text-lg">{item.title}</h3>
                  <p class="mt-1.5 text-lg font-normal tracking-[0.06em]">{item.price}</p>
                  <div class="pc-lines mt-3 flex-1 text-[1rem] font-normal italic leading-snug text-white/85">
                    {item.lines.map((line) => (<p>{line}</p>))}
                  </div>
                  {item.bookable && (
                    <a
                      href={getLocalizedPath('/booking', lang)}
                      class="mt-5 inline-flex items-center justify-center self-start rounded-full bg-white px-6 py-3 text-[0.78rem] font-semibold uppercase not-italic tracking-[0.14em] text-[#5B1F2E] transition-colors duration-300 hover:bg-[#F3E6E1] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                    >
                      {t('pricing.action.book')}
                    </a>
                  )}
                </li>
              ))}
            </ul>
            {group.private && (
              <p class="pc-private mt-1 flex items-center justify-center gap-2 text-center text-sm text-[#4a3a40]">
                <Lock class="h-3.5 w-3.5 flex-shrink-0" aria-hidden="true" />
                {t('pricing.private')}
              </p>
            )}
          </>
        ))
      }
    </div>

    <p class="pc-policy mx-auto mt-8 max-w-4xl text-center text-xs leading-relaxed text-[#4a3a40]">
      {t('pricing.policy')}
    </p>
  </div>
</section>

<style>
  .price-card {
    background: linear-gradient(145deg, #6A2440, #4A1D33);
    box-shadow: 0 24px 50px -32px rgba(74, 29, 51, 0.7);
  }

  /* Laptops and short windows: tighten the spacing so the whole section still fits in one screen */
  @media (min-width: 1024px) and (max-height: 880px) {
    .pc-section { padding-block: 1.1rem !important; }
    .pc-head { margin-bottom: 0.9rem; }
    .pc-head h2 { font-size: 2.1rem; }
    .pc-grid { row-gap: 0.7rem !important; }
    .price-card { padding-block: 0.95rem; }
    .price-card .pc-lines { margin-top: 0.45rem; font-size: 0.95rem; }
    .price-card a { margin-top: 0.7rem; padding-block: 0.6rem; }
    .pc-policy { margin-top: 1rem; }
  }
  @media (min-width: 1024px) and (max-height: 700px) {
    .pc-head h2 { font-size: 1.8rem; }
    .price-card { padding-block: 0.7rem; }
    .price-card h3 { font-size: 0.95rem; }
    .price-card .pc-lines { font-size: 0.9rem; }
  }
  @media (min-width: 1024px) {
    .pc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: auto 1fr 1fr auto; row-gap: 1rem; }
    .pc-head { grid-column: var(--c); grid-row: 1; margin-bottom: 0.9rem; }
    .price-card { grid-column: var(--c); grid-row: var(--r); }
    .pc-private { grid-column: 2; grid-row: 4; }
  }
  .pc-head { margin-bottom: 0.5rem; }
</style>
