---
import { Lock } from 'lucide-astro';
import { INITIAL_ASSESSMENT_PRICE } from '../../config/booking';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const en = lang === 'en';

// Only the initial assessment is bookable from the site; the rest are booked
// through private links sent after the first consultation.
const groups = [
  {
    kicker: en ? 'First consultation' : 'Consulta inicial',
    heading: en ? 'It’s my first time' : 'Es mi primera vez',
    items: [
      {
        title: en ? 'Initial assessment' : 'Valoración inicial',
        price: INITIAL_ASSESSMENT_PRICE,
        lines: [en ? '75-minute consultation' : 'Consulta de 75 minutos'],
        bookable: true,
      },
      {
        title: en ? 'Your personalised plan session' : 'Sesión de entrega del plan personalizado',
        price: '70 €',
        lines: [en ? '60-minute consultation' : 'Consulta de 60 minutos'],
      },
    ],
  },
  {
    kicker: en ? 'Follow-up sessions' : 'Consulta de revisión',
    heading: en ? 'I’m already a patient' : 'Ya soy paciente',
    private: true,
    items: [
      {
        title: en ? 'Follow-up session' : 'Sesión de seguimiento',
        price: '65 €',
        lines: [en ? '45-minute consultation' : 'Consulta de 45 minutos'],
      },
      {
        title: en ? 'Bundle of 4 follow-ups' : 'Bono de 4 seguimientos',
        price: '240 €',
        lines: en ? ['4 sessions of 45 minutes', '€60 per session'] : ['4 consultas de 45 minutos', '60 € por consulta'],
      },
    ],
  },
];
---

<section id="pide-cita" class="scroll-mt-[var(--hdr,88px)]">
  {
    groups.map((group, gi) => (
      <div class={`band ${gi === 0 ? 'band-a' : 'band-b'}`}>
        {gi === 0 && (
          <div class="sec-top mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
            <span class="eyebrow">{en ? 'Book an appointment' : 'Pide cita'}</span>
            <span class="sec-rule" aria-hidden="true"></span>
          </div>
        )}
        <p class="kick">{group.kicker}</p>
        <h2 class="big">{group.heading}</h2>

        <!-- Both cards have exactly the same size -->
        <ul role="list" class="card">
          {group.items.map((item) => (
            <li class="item">
              <div>
                <h3 class="item-title">{item.title}</h3>
                <div class="item-lines">
                  {item.lines.map((line) => (<p>{line}</p>))}
                </div>
              </div>
              <span class="price">{en ? item.price.replace(/^(\d+) €$/, '€$1') : item.price}</span>
              {item.bookable && (
                <a href="#reserva" class="pill">{t('pricing.action.book')}</a>
              )}
            </li>
          ))}
        </ul>

        {group.private && (
          <p class="private">
            <Lock class="h-3.5 w-3.5 flex-shrink-0" aria-hidden="true" />
            {t('pricing.private')}
          </p>
        )}
        {gi === groups.length - 1 && (
          <p class="policy">{t('pricing.policy')}</p>
        )}
      </div>
    ))
  }
</section>

<style>
  .band { padding: 3.5rem 1rem 4rem; text-align: center; }
  .band-a { background: #FAF8F4; padding-top: 3rem; }
  .band-b { background: #F3EBE3; }
  .band-a .sec-top { margin-bottom: 2.4rem; }
  .kick { font-family: 'Montserrat', sans-serif; font-size: 0.8rem; font-weight: 400; letter-spacing: 0.22em; text-transform: uppercase; color: #6b5f63; }
  .big { font-family: 'Cormorant', serif; font-weight: 300; font-size: clamp(2.2rem, 5vw, 3rem); line-height: 1.1; color: #2b2326; margin: 0.2rem 0 1.8rem; }
  .card {
    list-style: none; padding: 0; margin: 0 auto; width: 100%; max-width: 40rem; text-align: left;
    background: #fff; border: 1px solid rgba(43, 35, 38, 0.13); border-radius: 1.4rem;
    box-shadow: 0 26px 50px -40px rgba(74, 29, 51, 0.4);
  }
  /* Every row is as tall as the one with the button, so both cards come out identical */
  .item { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0.5rem 1.2rem; padding: 1.6rem 1.8rem; min-height: 11.5rem; }
  .item + .item { border-top: 1px solid rgba(43, 35, 38, 0.13); }
  .item-title { font-family: 'Montserrat', sans-serif; font-size: 0.86rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.5; color: #2b2326; }
  .item-lines { margin-top: 0.3rem; }
  .item-lines p { font-size: 0.9rem; font-style: italic; color: #6b5f63; line-height: 1.5; }
  .price { font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 1.55rem; letter-spacing: 0.02em; color: #2b2326; white-space: nowrap; }
  .pill {
    grid-column: 1 / -1; justify-self: start; margin-top: 0.7rem; display: inline-flex; align-items: center; border-radius: 9999px; background: #79264D; color: #fff;
    font-family: 'Montserrat', sans-serif; font-size: 0.74rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.85rem 1.6rem; font-style: normal; transition: background 0.3s;
  }
  .pill:hover, .pill:focus-visible { background: #4A1D33; }
  .private { display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 1.2rem; font-size: 0.82rem; color: #6b5f63; }
  .policy { max-width: 46rem; margin: 2.2rem auto 0; font-size: 0.78rem; line-height: 1.7; color: #6b5f63; }
  @media (max-width: 520px) { .item { padding: 1.3rem 1.2rem; } }
</style>
