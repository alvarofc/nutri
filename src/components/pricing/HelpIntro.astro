---
import { getLangFromUrl } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';

const areas = [
  {
    id: 'tratamiento-digestivo',
    title: es ? 'Tratamiento de patologías digestivas' : 'Treatment of digestive conditions',
    text: es
      ? 'Gastritis, intestino irritable, Helicobacter pylori, SIBO, malas digestiones, candidiasis recurrente, estreñimiento, diarreas, gases e hinchazón.'
      : 'Gastritis, irritable bowel syndrome, Helicobacter pylori, SIBO, poor digestion, recurrent candidiasis, constipation, diarrhoea, gas and bloating.',
  },
];
---

<section id="como-puedo-ayudarte" class="relative scroll-mt-[4.5rem] overflow-hidden bg-[#E4D3D3] pb-16 pt-24 sm:pb-24 sm:pt-28">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="sec-top !m-0 !mb-8 !max-w-none !text-base">
      <span class="eyebrow">{es ? 'Áreas de especialización' : 'Areas of expertise'}</span>
      <span class="sec-rule" aria-hidden="true"></span>
    </h2>

    <div class="max-w-3xl">
      {areas.map((area) => (
        <div id={area.id} class="scroll-mt-[6rem] border-t border-brand-accent/20 py-6">
          <h3 class="mb-2 text-[0.82rem] font-semibold uppercase leading-snug tracking-[0.06em] text-brand-accent" style="font-family: 'Montserrat', sans-serif !important; letter-spacing: 0.06em !important;">
            {area.title}
          </h3>
          <p class="text-[0.95rem] leading-relaxed text-[#2F1B24]">{area.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
