---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';
const t = useTranslations(lang);

const steps = [
  {
    n: '1',
    eyebrow: es ? 'Primer encuentro' : 'First meeting',
    short: es ? 'Primer encuentro' : 'First meeting',
    title: es ? 'Valoración inicial' : 'Initial assessment',
    chips: ['75 min'],
    lead: es
      ? 'Un espacio seguro donde buscamos comprender qué está pasando en tu cuerpo.'
      : 'A safe space where we look to understand what is happening in your body.',
    blocks: es
      ? [
          { label: 'Qué exploramos', items: ['Tus síntomas y su evolución', 'Tu descanso, digestión y niveles de energía', 'Tu actividad física'] },
          { label: 'Qué buscamos', text: 'Posibles factores que contribuyen al problema: desórdenes hormonales, alteraciones de la microbiota, déficits nutricionales, estrés…' },
          {
            label: 'Qué revisamos',
            items: [
              'Tu historia clínica, medicación, analíticas y otras pruebas diagnósticas',
              'Tu alimentación y las barreras que te lo ponen difícil (falta de tiempo, planificación, motivación…)',
            ],
          },
          { label: 'Al terminar', text: 'Acordamos objetivos a corto y largo plazo. Con todo lo recogido preparo tu plan personalizado, que te entrego y te explico en la segunda visita.' },
        ]
      : [
          { label: 'What we explore', items: ['Your symptoms and how they have evolved', 'Your rest, digestion and energy levels', 'Your physical activity'] },
          { label: 'What we look for', text: 'Possible factors contributing to the problem: hormonal imbalances, changes in the microbiota, nutritional deficiencies, stress…' },
          {
            label: 'What we review',
            items: [
              'Your medical history, medication, blood tests and other diagnostic tests',
              'How you eat and the barriers that make it hard today (lack of time, planning, motivation…)',
            ],
          },
          { label: 'At the end', text: 'We agree on short- and long-term goals. With everything gathered I prepare your personalised plan, which I deliver and explain in the second visit.' },
        ],
  },
  {
    n: '2',
    eyebrow: es ? 'Segundo encuentro' : 'Second meeting',
    short: es ? 'Segundo encuentro' : 'Second meeting',
    title: es ? 'Plan personalizado' : 'Personalised plan',
    chips: es ? ['60 min', 'En un plazo de 5 días laborables'] : ['60 min', 'Within 5 working days'],
    lead: es
      ? 'Te entrego y te explico en detalle tu plan, elaborado a partir de todo lo recogido en la valoración inicial.'
      : 'I deliver and explain your plan in detail, built from everything gathered in the initial assessment.',
    blocks: es
      ? [
          { label: 'Entenderás', text: 'Qué está sucediendo en tu cuerpo y qué necesita.' },
          {
            label: 'Recibirás',
            highlight: true,
            items: [
              'Un plan de alimentación individualizado, adaptado a tus requerimientos y a tu objetivo inicial',
              'Recomendaciones dietético‑conductuales: hábitos antiinflamatorios, pautas prácticas y ajustes sencillos para tu día a día',
              'Si procede, una pauta de suplementación explicada (qué, para qué y cómo tomarla)',
            ],
          },
          { label: 'Durante la sesión', text: 'Lo revisamos todo contigo, resolvemos dudas y hacemos los ajustes necesarios para que todo encaje contigo.' },
        ]
      : [
          { label: 'You will understand', text: 'What is happening in your body and what it needs.' },
          {
            label: 'You will receive',
            highlight: true,
            items: [
              'An individualised meal plan, adapted to your requirements and your initial goal',
              'Dietary and behavioural recommendations: anti-inflammatory habits, practical guidelines and simple adjustments for your day to day',
              'Where appropriate, a clearly explained supplementation guide (what, what for and how to take it)',
            ],
          },
          { label: 'During the session', text: 'We review everything together, answer your questions and make the adjustments needed so that everything fits you.' },
        ],
  },
  {
    n: '3',
    eyebrow: es ? 'Después' : 'Afterwards',
    short: es ? 'Seguimiento' : 'Follow-up',
    title: es ? 'Visitas de seguimiento' : 'Follow-up visits',
    chips: es ? ['45 min', 'Cada 2 a 6 semanas'] : ['45 min', 'Every 2 to 6 weeks'],
    lead: es
      ? 'El espacio donde revisamos cómo estás respondiendo al plan y cómo te sientes en el proceso.'
      : 'The space where we review how you are responding to the plan and how you are feeling during the process.',
    blocks: es
      ? [
          { label: 'Valoramos tu evolución', text: 'Síntomas, energía, digestión, composición corporal…' },
          { label: 'Ajustamos', text: 'Las pautas, para que la estrategia siga alineada con tus objetivos y tu momento vital.' },
          { label: 'Trabajamos', items: ['Consolidar hábitos', 'Resolver dudas', 'Desbloquear cualquier dificultad que surja por el camino'] },
          { label: 'Después de cada sesión', text: 'Recibes por correo las recomendaciones actualizadas y el material complementario.' },
        ]
      : [
          { label: 'We assess your progress', text: 'Symptoms, energy, digestion, body composition…' },
          { label: 'We adjust', text: 'The guidelines, so the strategy stays aligned with your goals and your stage of life.' },
          { label: 'We work on', items: ['Consolidating habits', 'Answering your questions', 'Unblocking any difficulty that comes up along the way'] },
          { label: 'After each session', text: 'You receive the updated recommendations and any supporting material by email.' },
        ],
  },
];

// One line icon per block, same order as the blocks of each step
const iconPaths: Record<string, string> = {
  search: 'M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z',
  eye: 'M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7zM12 15a3 3 0 100-6 3 3 0 000 6z',
  doc: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  flag: 'M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2z',
  bulb: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  check: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
  chat: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  chart: 'M7 14l3-3 3 3 4-5M4 4v15a1 1 0 001 1h15',
  sliders: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4',
  refresh: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  mail: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
};
const blockIcons = [
  ['search', 'eye', 'doc', 'flag'],
  ['bulb', 'check', 'chat'],
  ['chart', 'sliders', 'refresh', 'mail'],
];
---

<section id="en-que-consisten-las-sesiones" class="relative scroll-mt-[var(--hdr,88px)] bg-[#E4D3D3] py-14 sm:py-20" data-process>
  <div class="sec-top mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <span class="eyebrow">{es ? 'En qué consisten las sesiones' : 'What the sessions involve'}</span>
    <span class="sec-rule" aria-hidden="true"></span>
  </div>
  <h2 class="px-4 pt-0 text-center font-serif text-3xl leading-[1.05] text-brand-black sm:text-4xl lg:text-[2.9rem]">
    {t('pricing.title')}
  </h2>

  <!-- Three steps, one after the other, joined by a thread -->
  <ol class="steps mx-auto mt-12 max-w-6xl px-4 sm:px-6 lg:mt-16 lg:px-8">
    {steps.map((step, i) => (
      <li class="step">
        <div class="step-rail" aria-hidden="true">
          <span class="step-num">{step.n}</span>
          <span class="step-line"></span>
        </div>

        <div class="step-body">
          <!-- Which step it is, how long it lasts and what it is for -->
          <div class="step-left">
            <p class="mb-2 text-xs font-medium uppercase tracking-[0.2em] text-brand-muted">{step.eyebrow}</p>
            <h3 class="step-title">{step.title}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {step.chips.map((chip) => (
                <li class="rounded-full bg-brand-accent/10 px-3 py-1 text-xs font-medium tracking-wide text-brand-accent">{chip}</li>
              ))}
            </ul>
            {step.lead && <p class="step-lead">{step.lead}</p>}
          </div>

          <!-- The same kind of card every time, one idea per card -->
          <div class={`proc-cards grid gap-3 ${step.blocks.length === 4 ? 'md:grid-cols-2' : ''}`}>
            {step.blocks.map((block, j) => (
              <section class={`proc-card ${block.highlight ? 'is-key' : ''} ${block.big ? 'is-big' : ''}`}>
                <h4 class="proc-card-h">
                  <span class="proc-ico" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={iconPaths[blockIcons[i][j]]} /></svg>
                  </span>
                  {block.label}
                </h4>
                {block.text && <p class="proc-card-p">{block.text}</p>}
                {block.items && (
                  <ul class="proc-card-ul">
                    {block.items.map((item) => (<li>{item}</li>))}
                  </ul>
                )}
              </section>
            ))}
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .steps { list-style: none; }
  .step { position: relative; display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); column-gap: 1rem; padding-bottom: 3.25rem; }
  .step:last-child { padding-bottom: 0; }
  .step-rail { display: flex; flex-direction: column; align-items: center; }
  .step-num {
    display: flex; height: 2.75rem; width: 2.75rem; flex: none; align-items: center; justify-content: center; border-radius: 9999px;
    background: linear-gradient(145deg, #79264D, #4A1D33); color: #fff; font-family: 'Cormorant', serif; font-size: 1.6rem; font-weight: 500; line-height: 1;
    box-shadow: 0 10px 22px -12px rgba(74, 29, 51, 0.7);
  }
  .step-line { margin-top: 0.7rem; width: 1px; flex: 1; background: linear-gradient(to bottom, rgba(121, 38, 77, 0.5), rgba(121, 38, 77, 0.12)); }
  .step:last-child .step-line { display: none; }
  .step-body { display: grid; gap: 1.4rem; min-width: 0; }
  .step-title { font-family: 'Cormorant', serif; font-weight: 500; font-size: 2.1rem; line-height: 1.05; color: var(--tw-prose, #222); }
  .step-lead { margin-top: 1.1rem; border-left: 2px solid rgba(74, 29, 51, 0.4); padding-left: 1rem; font-family: 'Cormorant', serif; font-style: italic; font-size: 1.3rem; line-height: 1.3; color: #222; }

  @media (min-width: 640px) {
    .step { grid-template-columns: 3.25rem minmax(0, 1fr); column-gap: 1.5rem; }
    .step-num { height: 3.25rem; width: 3.25rem; font-size: 1.85rem; }
    .step-title { font-size: 2.4rem; }
  }
  @media (min-width: 1024px) {
    .step { grid-template-columns: 3.75rem minmax(0, 1fr); column-gap: 2rem; padding-bottom: 4.5rem; }
    .step-num { height: 3.75rem; width: 3.75rem; font-size: 2.1rem; }
    .step-title { font-size: 2.7rem; }
  }
  /* Wide screens: text on the left (it stays in view while you read the cards), cards on the right */
  @media (min-width: 1280px) {
    .step-body { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 3.5rem; align-items: start; }
    .step-left { position: sticky; top: calc(var(--hdr, 88px) + 1.5rem); }
  }

  /* The cards: same shape in the three steps */
  .proc-card {
    border-radius: 1rem; border: 1px solid rgba(74, 29, 51, 0.1); background: rgba(255, 255, 255, 0.78);
    padding: 1.1rem 1.25rem; box-shadow: 0 10px 28px -22px rgba(74, 29, 51, 0.5);
  }
  .proc-card-h {
    display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.65rem;
    font-family: 'Montserrat', sans-serif !important; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: #79264D;
  }
  .proc-ico { display: inline-flex; height: 1.9rem; width: 1.9rem; flex: none; align-items: center; justify-content: center; border-radius: 9999px; background: rgba(121, 38, 77, 0.1); color: #79264D; }
  .proc-ico svg { height: 1.05rem; width: 1.05rem; }
  .proc-card-p, .proc-card-ul { font-size: 1rem; line-height: 1.6; color: #3f3f3f; }
  .proc-card-ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .proc-card-ul li { position: relative; padding-left: 1.05rem; }
  .proc-card-ul li::before { content: ''; position: absolute; left: 0; top: 0.66em; height: 0.32rem; width: 0.32rem; border-radius: 9999px; background: #79264D; }
  /* Step 3: a single card with one sentence */
  .proc-card.is-big { padding: 1.5rem 1.6rem; }
  .proc-card.is-big .proc-card-p { font-family: 'Cormorant', serif; font-size: 1.5rem; line-height: 1.3; color: #3a1d2b; }
  /* The one card that holds what you take home */
  .proc-card.is-key { background: linear-gradient(145deg, #79264D, #4A1D33); border-color: transparent; }
  .proc-card.is-key .proc-card-h { color: #F3E6E1; }
  .proc-card.is-key .proc-ico { background: rgba(255, 255, 255, 0.16); color: #fff; }
  .proc-card.is-key .proc-card-p, .proc-card.is-key .proc-card-ul { color: #F8EDEA; }
  .proc-card.is-key .proc-card-p, .proc-card.is-key .proc-card-ul li { text-align: justify; hyphens: none; }
  .proc-card.is-key .proc-card-ul li::before { background: #E8C9D4; }
</style>
