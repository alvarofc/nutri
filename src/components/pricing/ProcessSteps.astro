---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';
const t = useTranslations(lang);

const steps = [
  {
    n: '1',
    eyebrow: es ? 'Primer encuentro' : 'First meeting',
    short: es ? 'Primer encuentro' : 'First meeting',
    title: es ? 'Valoración inicial' : 'Initial assessment',
    chips: ['75 min'],
    lead: es
      ? 'Un espacio seguro donde buscamos comprender qué está pasando en tu cuerpo.'
      : 'A safe, welcoming space to understand what is really going on in your body.',
    blocks: es
      ? [
          { label: 'Qué exploramos', items: ['Tus síntomas y su evolución', 'Tu descanso, digestión y niveles de energía', 'Tu actividad física'] },
          { label: 'Qué buscamos', text: 'Posibles factores que contribuyen al problema: desórdenes hormonales, alteraciones de la microbiota, déficits nutricionales, estrés…' },
          {
            label: 'Qué revisamos',
            items: [
              'Tu historia clínica, medicación, analíticas y otras pruebas diagnósticas',
              'Tu alimentación y las barreras que te lo ponen difícil (falta de tiempo, planificación, motivación…)',
            ],
          },
          { label: 'Al terminar', text: 'Acordamos objetivos a corto y largo plazo. Con todo lo recogido preparo tu plan personalizado, que te entrego y te explico en la segunda visita.' },
        ]
      : [
          { label: 'What we explore together', items: ['Your symptoms and how they have developed over time', 'Your sleep, digestion and energy levels', 'Your physical activity'] },
          { label: 'What we look for', text: 'The factors that may be contributing to your symptoms: hormonal imbalances, changes in the gut microbiota, nutritional deficiencies, stress…' },
          {
            label: 'What we review',
            items: [
              'Your medical history, medication, blood tests and other diagnostic results',
              'How you eat now, and what gets in the way (lack of time, planning, motivation…)',
            ],
          },
          { label: 'At the end', text: 'We agree on your short- and long-term goals. Using everything we have discussed, I prepare your personalised plan, which I present and talk you through in your second session.' },
        ],
  },
  {
    n: '2',
    eyebrow: es ? 'Segundo encuentro' : 'Second meeting',
    short: es ? 'Segundo encuentro' : 'Second meeting',
    title: es ? 'Plan personalizado' : 'Personalised plan',
    chips: es ? ['60 min', 'En un plazo de 5 días laborables'] : ['60 min', 'Within 5 working days'],
    lead: es
      ? 'Te entrego y te explico en detalle tu plan, elaborado a partir de todo lo recogido en la valoración inicial.'
      : 'I walk you through your plan in detail, built around everything we uncovered in your initial assessment.',
    blocks: es
      ? [
          { label: 'Entenderás', text: 'Qué está sucediendo en tu cuerpo y qué necesita.' },
          {
            label: 'Recibirás',
            highlight: true,
            items: [
              'Un plan de alimentación individualizado, adaptado a tus requerimientos y a tu objetivo inicial',
              'Recomendaciones dietético‑conductuales: hábitos antiinflamatorios, pautas prácticas y ajustes sencillos para tu día a día',
              'Si procede, una pauta de suplementación explicada (qué, para qué y cómo tomarla)',
            ],
          },
          { label: 'Durante la sesión', text: 'Lo revisamos todo contigo, resolvemos dudas y hacemos los ajustes necesarios para que todo encaje contigo.' },
        ]
      : [
          { label: 'You will understand', text: 'What is happening in your body and what it needs.' },
          {
            label: 'You will receive',
            highlight: true,
            items: [
              'A tailored meal plan, designed around your nutritional needs and your main goal',
              'Diet and lifestyle guidance: anti-inflammatory habits, practical tips and simple tweaks for your everyday life',
              'Where appropriate, a clear supplement guide (what to take, why and how)',
            ],
          },
          { label: 'During the session', text: 'We go through everything together, answer your questions and fine-tune the plan so it works for you.' },
        ],
  },
  {
    n: '3',
    eyebrow: es ? 'Después' : 'Afterwards',
    short: es ? 'Seguimiento' : 'Follow-up',
    title: es ? 'Visitas de seguimiento' : 'Follow-up visits',
    chips: es ? ['45 min', 'Cada 2 a 6 semanas'] : ['45 min', 'Every 2 to 6 weeks'],
    lead: es
      ? 'El espacio donde revisamos cómo estás respondiendo al plan y cómo te sientes en el proceso.'
      : 'Regular check-ins to see how you are responding to your plan and how you are feeling along the way.',
    blocks: es
      ? [
          { label: 'Valoramos tu evolución', text: 'Síntomas, energía, digestión, composición corporal…' },
          { label: 'Ajustamos', text: 'Las pautas, para que la estrategia siga alineada con tus objetivos y tu momento vital.' },
          { label: 'Trabajamos', items: ['Consolidar hábitos', 'Resolver dudas', 'Desbloquear cualquier dificultad que surja por el camino'] },
          { label: 'Después de cada sesión', text: 'Recibes por correo las recomendaciones actualizadas y el material complementario.' },
        ]
      : [
          { label: 'We track your progress', text: 'Symptoms, energy, digestion, body composition…' },
          { label: 'We adjust your plan', text: 'Updating your guidelines so your approach stays aligned with your goals and your stage of life.' },
          { label: 'We focus on', items: ['Building lasting habits', 'Answering your questions', 'Working through any obstacles that come up along the way'] },
          { label: 'After every session', text: 'You receive your updated recommendations and any supporting materials by email.' },
        ],
  },
];

---

<section id="en-que-consisten-las-sesiones" class="process relative scroll-mt-[var(--hdr,88px)] py-14 sm:py-20" data-process>
  <div class="sec-top mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <span class="eyebrow">{es ? 'En qué consisten las sesiones' : 'What your sessions involve'}</span>
    <span class="sec-rule" aria-hidden="true"></span>
  </div>
  <h2 class="px-4 pt-0 text-center font-serif text-3xl font-light leading-[1.05] text-brand-black sm:text-4xl lg:text-[2.9rem]">
    {t('pricing.title')}
  </h2>

  <!-- Light timeline: a thin line, three dots, three soft cards -->
  <ol class="tl mx-auto mt-12 max-w-7xl px-4 sm:px-6 lg:mt-14 lg:px-8">
    {steps.map((step) => (
      <li class="step">
        <span class="dot" aria-hidden="true"></span>
        <div class="glass">
          <p class="label">{step.n} · {step.eyebrow}</p>
          <h3 class="step-title">{step.title}</h3>
          <ul class="chips">
            {step.chips.map((chip) => (<li class="chip">{chip}</li>))}
          </ul>
          {step.lead && <p class="lead-p">{step.lead}</p>}

          {step.blocks.map((block) => (
            <div class={`blk ${block.highlight ? 'is-key' : ''}`}>
              <h4 class="label">{block.label}</h4>
              {block.text && <p class="txt">{block.text}</p>}
              {block.items && (
                <ul class="txt-ul">
                  {block.items.map((item) => (<li>{item}</li>))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </li>
    ))}
  </ol>

  <!-- Booking -->
  <div class="mt-12 px-4 text-center lg:mt-16">
    <a
      href={getLocalizedPath('/booking', lang)}
      class="cta-gradient-btn relative inline-flex items-center justify-center overflow-hidden rounded-full bg-brand-accent px-10 py-4 text-base font-medium text-white transition-all duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
    >
      <span class="relative z-10">{es ? 'Reserva tu consulta' : 'Book your consultation'}</span>
    </a>
  </div>
</section>

<style>
  .process { background: linear-gradient(180deg, #FAF8F4, #F3EBE3); }
  .tl { list-style: none; display: grid; gap: 1.6rem; position: relative; padding-block: 0; }
  .step { position: relative; display: flex; flex-direction: column; }
  .dot { display: none; }
  .glass {
    flex: 1; border-radius: 1.2rem; padding: 1.5rem 1.4rem 1.7rem;
    background: rgba(255, 255, 255, 0.66); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.9); box-shadow: 0 22px 46px -36px rgba(74, 29, 51, 0.38);
  }
  .label { font-family: 'Montserrat', sans-serif !important; font-size: 0.7rem !important; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: #79264D; margin: 0; }
  .step-title { font-family: 'Cormorant', serif; font-weight: 500; font-size: 1.9rem; line-height: 1.08; color: #2b2326; margin: 0.35rem 0 0.7rem; }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0 0 0.9rem; }
  .chip { font-family: 'Montserrat', sans-serif; font-size: 0.68rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: #6b5f63; border: 1px solid rgba(43, 35, 38, 0.14); border-radius: 9999px; padding: 0.28rem 0.75rem; background: rgba(255, 255, 255, 0.6); }
  .lead-p { font-size: 0.95rem; line-height: 1.65; color: #4a4044; margin: 0; }
  .blk { margin-top: 1rem; padding-top: 0.9rem; border-top: 1px solid rgba(43, 35, 38, 0.13); }
  .blk .label { margin-bottom: 0.4rem; }
  .txt { font-size: 0.93rem; line-height: 1.65; color: #4a4044; margin: 0; }
  .txt-ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.4rem; }
  .txt-ul li { position: relative; padding-left: 1rem; font-size: 0.93rem; line-height: 1.6; color: #4a4044; }
  .txt-ul li::before { content: ''; position: absolute; left: 0; top: 0.68em; height: 0.3rem; width: 0.3rem; border-radius: 9999px; background: #79264D; }
  /* What you take home: a soft rose tint and a thin line, nothing dark */
  .blk.is-key { background: #F6EAE6; border-top: 0; border-left: 2px solid #79264D; border-radius: 0.8rem; padding: 0.9rem 1rem; }

  @media (min-width: 1024px) {
    .tl { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.6rem; }
    .tl::before { content: ''; position: absolute; left: 2rem; right: 2rem; top: 9px; height: 1px; background: rgba(43, 35, 38, 0.16); }
    .step { padding-top: 2.4rem; }
    .dot { display: block; position: absolute; top: 3px; left: 0; height: 13px; width: 13px; border-radius: 9999px; background: #FAF8F4; border: 1.5px solid #79264D; }
  }
</style>
