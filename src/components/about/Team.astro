---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const team = [
  {
    name: t('team.floyd.name'),
    image: '/assets/team-1.webp',
    job: t('team.floyd.job'),
  },
  {
    name: t('team.emma.name'),
    image: '/assets/team-2.webp',
    job: t('team.emma.job'),
  },
  {
    name: t('team.emily.name'),
    image: '/assets/team-3.webp',
    job: t('team.emily.job'),
  },
];
---

<section class="relative py-24 sm:py-32 overflow-hidden border-t border-brand-accent/10">
  <!-- Soft lavender to peach gradient background -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#EBDDD6] via-[#E5D3C8] to-[#EBDDD6]"></div>
  
  <!-- Radial gradient for warm center glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(248,200,180,0.4)_0%,_transparent_70%)]"></div>
  
  <!-- Soft purple accents on sides -->
  <div class="absolute top-0 left-0 w-1/3 h-full bg-gradient-to-r from-[#E3CFC5]/50 to-transparent"></div>
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-[#E3CFC5]/50 to-transparent"></div>

  <div class="relative mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-16">
      <h2 class="font-serif text-4xl sm:text-5xl text-brand-black">{t('team.title')}</h2>
      
      <ul role="list" class="grid grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
        {
          team.map((item) => (
            <li class="group">
              <div class="aspect-[3/4] w-full overflow-hidden bg-white/50 rounded-2xl mb-6">
                <img 
                  class="h-full w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-105" 
                  src={item.image} 
                  alt={item.name} 
                />
              </div>
              <h3 class="font-serif text-2xl text-brand-black">{item.name}</h3>
              <p class="text-brand-muted font-light mt-1">{item.job}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
