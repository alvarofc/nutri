---
import PageHeader from '../PageHeader.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<PageHeader
  eyebrow={lang === 'en' ? 'My Story' : 'Mi Historia'}
  title={t('about.heading.title')}
  lead={t('about.heading.subtitle')}
  image="/assets/sobre-mi-cabecera-1.webp"
  alt={lang === 'en' ? 'Alexandra smiling in a park' : 'Alexandra sonriendo en un parque'}
  width={1140}
  height={760}
/>
