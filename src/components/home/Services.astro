---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    step: '01',
    name: t('services.step1.name'),
    description: t('services.step1.description'),
    image: '/assets/primera-visita.jpg',
    position: 'center'
  },
  {
    step: '02',
    name: t('services.step2.name'),
    description: t('services.step2.description'),
    image: '/assets/como-trabajo-2.jpg',
    position: 'center'
  },
  {
    step: '03',
    name: t('services.step3.name'),
    description: t('services.step3.description'),
    image: '/assets/como-trabajo-3.jpg',
    position: 'center 90%'
  },
];
---

<section class="relative pt-8 sm:pt-12 pb-20 sm:pb-28 overflow-hidden">
  <!-- Soft lavender to peach gradient background -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#E8E4F0] via-[#F0E6E8] to-[#F5E6DC]"></div>
  
  <!-- Radial gradient for warm center glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(248,200,180,0.5)_0%,_transparent_70%)]"></div>
  
  <!-- Soft purple accents on sides -->
  <div class="absolute top-0 left-0 w-1/3 h-full bg-gradient-to-r from-[#DCD4EA]/60 to-transparent"></div>
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-[#DCD4EA]/60 to-transparent"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 bg-white/60 text-brand-accent text-xs font-medium uppercase tracking-widest rounded-full mb-4 backdrop-blur-sm border border-white/40">
        {t('services.methodology')}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-medium text-brand-black mb-4">
        {t('services.title')}
      </h2>
      <p class="text-brand-muted max-w-xl mx-auto">
        {lang === 'es' 
          ? 'Un proceso personalizado diseñado para ti y tus objetivos únicos.'
          : 'A personalized process designed for you and your unique goals.'}
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((service, index) => (
        <div class="group bg-white/80 backdrop-blur-sm rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-white/60">
          <!-- Image -->
          <div class="aspect-[4/3] overflow-hidden">
            <img 
              src={service.image} 
              alt={service.name}
              style={`object-position: ${service.position}`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          
          <!-- Content -->
          <div class="p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-8 h-8 bg-gradient-to-br from-brand-accent to-[#6B5B95] rounded-full flex items-center justify-center text-sm font-medium text-white shadow-sm">
                {service.step}
              </span>
              <div class="flex-1 h-px bg-gradient-to-r from-brand-accent/30 to-transparent"></div>
            </div>
            <h3 class="text-xl font-serif font-medium text-brand-black mb-3 group-hover:text-brand-accent transition-colors">
              {service.name}
            </h3>
            <p class="text-brand-muted text-sm leading-relaxed">
              {service.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Quote -->
    <div class="mt-16 text-center">
      <blockquote
        class="text-brand-accent text-3xl sm:text-4xl leading-[1.2] tracking-tight italic max-w-3xl mx-auto"
        style="font-family: 'Cormorant', serif; font-weight: 400"
      >
        “{lang === 'es'
          ? 'Nutre tu mente, cuerpo y microbiota'
          : 'Nourish your mind, body and microbiota'}”
      </blockquote>
    </div>
  </div>
</section>
