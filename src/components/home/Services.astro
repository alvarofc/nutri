---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';
import SectionHeader from '../layout/SectionHeader.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const bookingHref = getLocalizedPath('/pricing', lang);

const services = [
  {
    step: '01',
    name: t('services.step1.name'),
    description: t('services.step1.description'),
    image: '/assets/como-trabajo-granada-1.jpg',
    position: 'center'
  },
  {
    step: '02',
    name: t('services.step2.name'),
    description: t('services.step2.description'),
    image: '/assets/como-trabajo-granada-2.jpg',
    position: 'center'
  },
  {
    step: '03',
    name: t('services.step3.name'),
    description: t('services.step3.description'),
    image: '/assets/como-trabajo-granada-3.jpg',
    position: 'center'
  },
];
---

<section id="como-trabajo" class="[&_.lead]:text-[#4A1D33] [&_.eyebrow]:text-[#79264D] relative flex flex-col justify-center py-16 sm:py-20 overflow-hidden scroll-mt-[4.5rem]">
  <!-- Soft lavender to peach gradient background -->
  <div class="absolute inset-0 bg-[#EBDDD6]"></div>

  <div class="relative w-full mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <SectionHeader
      eyebrow={lang === 'es' ? 'Paso a paso' : 'Step by step'}
      title={t('services.title')}
      lead={lang === 'es'
        ? 'Un proceso personalizado diseñado para ti y tus objetivos únicos.'
        : 'A personalized process designed for you and your unique goals.'}
    />

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((service, index) => (
        <a
          href={bookingHref}
          class="step-card group relative block bg-white/80 backdrop-blur-sm rounded-2xl overflow-hidden border border-white/60"
        >
          <!-- Image -->
          <div class="aspect-[4/3] overflow-hidden">
            <img 
              src={service.image} 
              alt={service.name}
              style={`object-position: ${service.position}`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          
          <!-- Content -->
          <div class="p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-4">
              <span class="step-num w-8 h-8 bg-gradient-to-br from-brand-accent to-[#79264D] rounded-full flex items-center justify-center text-sm font-medium text-white shadow-sm">
                {service.step}
              </span>
              <div class="flex-1 h-px bg-gradient-to-r from-brand-accent/30 to-transparent"></div>
            </div>
            <h3 class="text-xl font-serif font-medium text-brand-black mb-3 group-hover:text-brand-accent transition-colors">
              {service.name}
            </h3>
            <p class="text-brand-muted text-sm leading-relaxed">
              {service.description}
            </p>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom Quote -->
    <div class="mt-16 text-center">
      <a href={`${getLocalizedPath('/pricing', lang)}#en-que-consisten-las-sesiones`} class="eyebrow eyebrow-link mb-6">
        {lang === 'es' ? 'Saber más' : 'Learn more'}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <blockquote
        class="text-brand-accent text-3xl sm:text-4xl leading-[1.2] tracking-tight italic max-w-3xl mx-auto"
        style="font-family: 'Cormorant', serif; font-weight: 400"
      >
        “{lang === 'es'
          ? 'Nutre tu mente, cuerpo y microbiota'
          : 'Nourish your mind, body and microbiota'}”
      </blockquote>
    </div>
  </div>
</section>

<style>
  /* Cards sit straight and only move when the pointer is over them */
  .step-card {
    box-shadow: 0 1px 2px rgba(74, 29, 51, 0.06);
    transition:
      translate 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      scale 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    cursor: pointer;
  }
  .step-num {
    transition: rotate 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .step-card:hover .step-num,
  .step-card:focus-visible .step-num {
    rotate: 8deg;
  }
  .step-card:hover,
  .step-card:focus-visible {
    translate: 0 -0.5rem;
    scale: 1.04;
    box-shadow: 0 24px 44px -16px rgba(74, 29, 51, 0.28);
    z-index: 10;
    outline: none;
  }
  .step-card:focus-visible {
    box-shadow: 0 0 0 3px rgba(74, 29, 51, 0.35), 0 24px 44px -16px rgba(74, 29, 51, 0.28);
  }
  @media (prefers-reduced-motion: reduce) {
    .step-card,
    .step-num {
      transition: none;
    }
  }
</style>
