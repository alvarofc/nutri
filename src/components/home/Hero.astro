---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Social links
const socials = [
  { name: 'Instagram', href: 'https://www.instagram.com/tunutrialexandra/', icon: 'instagram' },
];
---

<section class="relative bg-brand-cream overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center min-h-[calc(100vh-72px)] pt-16 pb-8 lg:pt-24 lg:pb-10">
      
      <!-- Left: Content -->
      <div class="order-2 lg:order-1">
        <!-- Hero Headline -->
        <h1 class="text-5xl sm:text-6xl lg:text-7xl leading-[1.05] text-brand-accent mb-8">
          <span class="block">Smart</span>
          <span class="block italic whitespace-nowrap">Anti-inflammatory</span>
          <span class="block">Nutrition</span>
        </h1>

        <!-- Subtitle -->
        <div class="text-lg text-brand-gray font-light leading-relaxed mb-8 max-w-md space-y-4">
          {t('home.subtitle').split('\n\n').map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          <a
            href={getLocalizedPath('/pricing', lang)}
            class="cta-gradient-btn group relative overflow-hidden bg-brand-accent text-white px-8 py-4 text-sm font-medium rounded-full transition-all duration-300 flex items-center justify-center gap-2"
          >
            <span class="relative z-10">{lang === 'es' ? 'Reserva tu consulta online' : 'Book your online consultation'}</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a
            href={getLocalizedPath('/about', lang)}
            class="group border border-brand-black/20 text-brand-black px-8 py-4 text-sm font-medium rounded-full hover:border-brand-accent hover:text-brand-accent transition-all duration-300 flex items-center justify-center gap-2"
          >
            <span>{t('cta.learn')}</span>
          </a>
        </div>

        <!-- Location Info -->
        <div class="flex items-center gap-6 text-sm text-brand-muted">
          <span>{lang === 'es' ? 'Consulta online por videollamada · desde cualquier lugar' : 'Online consultations by video call · from anywhere'}</span>
        </div>
      </div>

      <!-- Right: Image -->
      <div class="order-1 lg:order-2 relative">
        <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-brand-blush">
          <img 
            src="/assets/alex-front.webp" 
            alt="Alexandra Ivanova"
            class="w-full h-full object-cover"
          />
          <!-- Decorative elements -->
          <div class="absolute -bottom-4 -left-4 w-24 h-24 bg-brand-accent/10 rounded-full blur-2xl"></div>
          <div class="absolute -top-4 -right-4 w-32 h-32 bg-brand-blush rounded-full blur-2xl"></div>
        </div>
        
        <!-- Floating badge -->
        <div class="absolute bottom-8 -left-4 sm:left-8 bg-white rounded-2xl shadow-lg p-4 sm:p-5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-brand-accent/10 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="font-medium text-brand-black text-sm">MAD01541</p>
              <p class="text-xs text-brand-muted">{lang === 'es' ? 'Colegiada' : 'Registered'}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
