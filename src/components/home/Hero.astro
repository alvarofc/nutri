---
import '@fontsource/albert-sans/latin-300.css';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Social links
const socials = [
  { name: 'Instagram', href: 'https://www.instagram.com/tunutrialexandra/', icon: 'instagram' },
];
---

<section class="relative bg-brand-cream overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[auto_minmax(0,30rem)] lg:justify-center gap-8 lg:gap-28 items-center lg:items-stretch pt-10 pb-8 lg:py-14">
      
      <!-- Left: Content. On wide screens everything shares the width of the name block, so it reads as one column -->
      <div class="order-2 lg:order-1 flex lg:items-center">
        <div class="w-full lg:w-fit lg:max-w-full">
          <!-- Name and credential line share one width: both scale from the same base size -->
          <div style="font-size: clamp(0.886rem, 1.732vw, 1.28rem);">
            <h1 class="leading-tight text-[#2E2367] mb-2 whitespace-nowrap" style="font-size: 2.54em;">
              {lang === 'es' ? 'Soy Alexandra Ivanova' : "I'm Alexandra Ivanova"}
            </h1>
            <p class="uppercase leading-5 tracking-[0.1em] text-brand-accent whitespace-nowrap" style="font-family: 'Albert Sans', sans-serif; font-weight: 300; font-size: 1em;">
              {lang === 'es' ? 'Dietista-Nutricionista (MAD01541)' : 'Dietitian-Nutritionist (MAD01541)'}
            </p>
            <p class="mt-3 lg:w-0 lg:min-w-full italic leading-snug text-brand-accent [text-wrap:balance]" style="font-family: 'Cormorant', serif; font-size: 1.35em;">
              {lang === 'es'
                ? 'especializada en salud hormonal y relación con la comida.'
                : 'specialized in hormonal health and relationship with food.'}
            </p>
          </div>

          <!-- Thin rule closes the heading block -->
          <div class="my-6 h-px bg-brand-accent/20 lg:w-0 lg:min-w-full"></div>

          <!-- Intro text: justified to the same column width -->
          <div class="space-y-3 lg:w-0 lg:min-w-full">
            {t('home.subtitle').split('\n\n').slice(1).map((paragraph, i, all) => (
              i === all.length - 1 ? (
                <p class="pt-2 text-2xl italic leading-snug text-brand-accent" style="font-family: 'Cormorant', serif;">{paragraph}</p>
              ) : (
                <p class="text-base text-brand-gray font-light leading-relaxed text-justify [text-wrap:pretty]" style="hyphens: none;">{paragraph}</p>
              )
            ))}
          </div>

          <!-- Actions: button as wide as the column, secondary link and note centred beneath -->
          <div class="mt-7 flex flex-wrap items-center justify-between gap-x-4 gap-y-3 lg:w-0 lg:min-w-full">
            <a
              href={getLocalizedPath('/pricing', lang)}
              class="cta-gradient-btn group relative overflow-hidden bg-brand-accent text-white px-5 py-2.5 text-[13px] font-medium rounded-full transition-all duration-300 inline-flex items-center justify-center gap-2"
            >
              <span class="relative z-10">{lang === 'es' ? 'Reserva tu consulta online' : 'Book your online consultation'}</span>
            </a>
            <a
              href="#como-trabajo"
              data-scroll-to="como-trabajo"
              class="eyebrow eyebrow-link"
            >
              <span>{t('cta.learn')}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Image -->
      <div class="order-1 lg:order-2 relative mx-auto w-full max-w-[clamp(16.5rem,62vw,26rem)] lg:mx-0 lg:max-w-none lg:h-full">
        <div class="relative aspect-[4/5] lg:aspect-auto lg:absolute lg:inset-0 rounded-2xl overflow-hidden bg-brand-blush">
          <img 
            src="/assets/alex-front.webp" 
            alt="Alexandra Ivanova"
            class="w-full h-full object-cover lg:object-[50%_62%]"
          />
          <!-- Decorative elements -->
          <div class="absolute -bottom-4 -left-4 w-24 h-24 bg-brand-accent/10 rounded-full blur-2xl"></div>
          <div class="absolute -top-4 -right-4 w-32 h-32 bg-brand-blush rounded-full blur-2xl"></div>
        </div>
        
        <!-- Floating badge -->
        <div class="absolute bottom-3 left-2 sm:bottom-4 sm:left-3 lg:bottom-8 lg:left-8 bg-white rounded-2xl shadow-lg p-2.5 sm:p-3 lg:p-5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-brand-accent/10 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="font-medium text-brand-black text-sm">MAD01541</p>
              <p class="text-xs text-brand-muted">{lang === 'es' ? 'Colegiada' : 'Registered'}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // "Saber más" glides down to the "¿Cómo trabajo?" section
  function setupScrollLinks() {
    document.querySelectorAll<HTMLAnchorElement>('[data-scroll-to]').forEach((link) => {
      if (link.dataset.bound) return;
      link.dataset.bound = '1';
      link.addEventListener('click', (event) => {
        const target = document.getElementById(link.dataset.scrollTo ?? '');
        if (!target) return;
        event.preventDefault();
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });
    });
  }
  document.addEventListener('astro:page-load', setupScrollLinks);
  setupScrollLinks();
</script>
