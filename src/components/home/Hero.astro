---
import '@fontsource/cormorant/latin-600-italic.css';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Social links
const socials = [
  { name: 'Instagram', href: 'https://www.instagram.com/tunutrialexandra/', icon: 'instagram' },
];
---

<section class="relative bg-brand-cream overflow-hidden">
  <!-- Plate with blueberries, cut out and 60% transparent: a big half-circle coming in from the right edge, reaching the middle of the portrait (placed by the script below) -->
  <img
    data-berries
    src="/assets/hero-plato-2.webp"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute left-0 top-1/2 hidden h-auto max-w-none -translate-y-1/2 opacity-40 lg:block"
    loading="lazy"
  />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!--
      Rows on wide screens:  1) name   2) title + specialty above the thin separator
                             3) intro + buttons.   The photo spans the three rows.
    -->
    <div class="grid grid-cols-1 gap-x-16 gap-y-0 pt-10 pb-8 lg:grid-cols-[calc(8.3*clamp(2.25rem,4.4vw,3.25rem))_minmax(0,27rem)] lg:justify-start lg:grid-rows-[auto_auto_1fr] lg:pt-14 lg:pb-14">

      <!-- Row 1: name -->
      <div class="order-2 mt-6 lg:order-none lg:col-start-1 lg:row-start-1 lg:mt-0">
        <h1 class="text-[#2E2367] leading-[1.05]" style="font-size: clamp(2.25rem, 4.4vw, 3.25rem);">
          {lang === 'es' ? 'Soy Alexandra Ivanova' : "I'm Alexandra Ivanova"}
        </h1>
      </div>

      <!-- Row 2: title + specialty, as wide as the name; the thin separator runs under the whole column -->
      <div class="order-3 mt-4 border-b border-brand-accent/20 pb-6 lg:order-none lg:col-start-1 lg:row-start-2">
        <div class="[container-type:inline-size] lg:w-[calc(8.3*clamp(2.25rem,4.4vw,3.25rem))]">
          <p class="text-brand-accent" style="font-family: 'Cormorant', serif; font-style: italic; font-weight: 600; font-size: clamp(1.05rem, 6.6cqw, 1.85rem); line-height: 1.3; letter-spacing: 0; text-align: justify; text-align-last: justify;" set:html={lang === 'es'
              ? 'Dietista<span style="font-family: Montserrat, sans-serif; font-style: normal; font-weight: 500; position: relative; top: 0.1em">-</span>nutricionista especializada en salud hormonal y relación con la comida.'
              : 'Dietitian<span style="font-family: Montserrat, sans-serif; font-style: normal; font-weight: 500; position: relative; top: 0.1em">-</span>nutritionist specialized in hormonal health and relationship with food.'}></p>
        </div>
      </div>

      <!-- Row 3: intro text and buttons -->
      <div class="order-4 mt-6 flex flex-col justify-between lg:order-none lg:col-start-1 lg:row-start-3">
        <div class="space-y-4">
          {t('home.subtitle').split('\n\n').slice(1).map((paragraph, i, all) => (
            i === all.length - 1 ? (
              <p class="text-[1.05rem] text-brand-gray font-normal leading-[1.6]">{paragraph}</p>
            ) : (
              <p class="text-justify text-[1.05rem] text-brand-gray font-light leading-[1.6] [text-wrap:pretty]" style="hyphens: none;">{paragraph}</p>
            )
          ))}
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-x-3 gap-y-4">
          <a
            href={getLocalizedPath('/pricing', lang)}
            class="cta-gradient-btn group relative overflow-hidden whitespace-nowrap bg-brand-accent text-white px-5 py-2.5 text-sm font-medium tracking-normal rounded-full transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            <span class="relative z-10">{lang === 'es' ? 'Reserva tu consulta online' : 'Book your online consultation'}</span>
          </a>
          <a
            href="#que-te-trae"
            data-scroll-to="que-te-trae"
            class="eyebrow eyebrow-link whitespace-nowrap"
          >
            <span>{t('cta.learn')}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Photo: spans the three rows; registration number in the bottom-right corner -->
      <div data-hero-photo class="relative z-10 order-1 mx-auto w-full max-w-[clamp(16.5rem,62vw,26rem)] lg:order-none lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:mx-0 lg:mt-[0.6rem] lg:mb-[0.4rem] lg:max-w-none">
        <div class="relative aspect-[4/5] lg:absolute lg:inset-0 lg:aspect-auto">
          <div class="absolute inset-0 overflow-hidden rounded-2xl bg-brand-blush">
            <img
              src="/assets/alex-front-2.webp"
              alt="Alexandra Ivanova"
              class="absolute inset-0 h-full w-full object-cover lg:origin-[50%_35%] lg:scale-[1.15] lg:object-[50%_62%]"
            />
          </div>
          <div class="absolute bottom-2 right-2 rounded-xl bg-white p-1.5 shadow-lg sm:bottom-4 sm:right-4 sm:rounded-2xl sm:p-3">
            <div class="flex items-center gap-2 sm:gap-3">
              <div class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-accent/10 sm:h-10 sm:w-10">
                <svg class="h-3.5 w-3.5 text-brand-accent sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-[11px] font-medium leading-tight text-brand-black sm:text-sm">MAD01541</p>
                <p class="text-[9px] leading-tight text-brand-muted sm:text-xs">{lang === 'es' ? 'Colegiada' : 'Registered'}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // The berries' left edge sits at the middle of the portrait; the cluster is as wide as needed
  // for its right half to run off the right edge of the screen (a half-circle).
  function placeBerries() {
    const img = document.querySelector<HTMLImageElement>('[data-berries]');
    const photo = document.querySelector<HTMLElement>('[data-hero-photo]');
    if (!img || !photo) return;
    const section = img.closest('section');
    if (!section || getComputedStyle(img).display === 'none') return;
    const s = section.getBoundingClientRect();
    const p = photo.getBoundingClientRect();
    const mid = p.left + p.width / 2 - s.left;
    img.style.left = `${mid}px`;
    img.style.width = `${2 * (s.width - mid)}px`;
  }
  document.addEventListener('astro:page-load', placeBerries);
  window.addEventListener('resize', placeBerries);
  placeBerries();
</script>

<script>
  // "Saber más" glides down to the next section ("¿Qué te trae por aquí?")
  function setupScrollLinks() {
    document.querySelectorAll<HTMLAnchorElement>('[data-scroll-to]').forEach((link) => {
      if (link.dataset.bound) return;
      link.dataset.bound = '1';
      link.addEventListener('click', (event) => {
        const target = document.getElementById(link.dataset.scrollTo ?? '');
        if (!target) return;
        event.preventDefault();
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });
    });
  }
  document.addEventListener('astro:page-load', setupScrollLinks);
  setupScrollLinks();
</script>
