---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';
import { whatsappUrl } from '../../config/contact';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="grid lg:grid-cols-2 bg-brand-accent text-white overflow-hidden">
  <!-- Text half -->
  <div class="flex flex-col justify-center px-6 py-16 sm:px-12 sm:py-20 lg:px-16 lg:py-24">
    <div class="max-w-md mx-auto lg:mx-0 lg:ml-auto lg:mr-10 w-full">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-medium mb-5">
        {t('cta.title')}
      </h2>

      <p class="font-sans text-base sm:text-lg font-light leading-relaxed text-white/90 mb-8">
        {lang === 'es'
          ? 'Empieza con una valoración inicial online: 75 minutos para entender qué le pasa a tu cuerpo y por dónde empezar.'
          : 'Start with an online initial assessment: 75 minutes to understand what is happening in your body and where to begin.'}
      </p>

      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href={getLocalizedPath('/pricing', lang)}
          class="inline-flex items-center justify-center gap-2 bg-white text-brand-accent px-7 py-3 font-sans text-sm font-medium rounded-full hover:bg-brand-cream transition-colors"
        >
          <span>{lang === 'es' ? 'Reserva tu valoración inicial' : 'Book your initial assessment'}</span>
        </a>
        <a
          href={getLocalizedPath('/contact', lang)}
          data-wa-href={whatsappUrl(lang)}
          class="inline-flex items-center justify-center gap-2 border border-white/40 text-white px-7 py-3 font-sans text-sm font-medium rounded-full hover:bg-white/10 transition-colors"
        >
          <span>{t('cta.button')}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Photo half -->
  <div
    class="min-h-[18rem] sm:min-h-[22rem] lg:min-h-0 bg-cover"
    style="background-image: url('/assets/higos.jpg'); background-position: 50% 62%;"
    role="img"
    aria-label={lang === 'es' ? 'Dos higos sobre un fondo blanco' : 'Two figs on a white background'}
  ></div>
</section>

<script>
  // On phones and tablets (touch screens) "Escríbeme" opens a WhatsApp chat; on a computer it goes to the contact page.
  function setupWhatsappLinks() {
    if (!window.matchMedia('(pointer: coarse)').matches) return;
    document.querySelectorAll<HTMLAnchorElement>('[data-wa-href]').forEach((link) => {
      link.href = link.dataset.waHref ?? link.href;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
    });
  }
  document.addEventListener('astro:page-load', setupWhatsappLinks);
  setupWhatsappLinks();
</script>
