---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative flex items-center bg-brand-accent text-white py-20 sm:py-28 overflow-hidden">
  <div class="w-full mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative text-center">
      <!-- Background decoration -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full blur-2xl"></div>
      
      <div class="relative z-10">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-medium mb-6 max-w-2xl mx-auto">
          {t('cta.title')}
        </h2>
        
        <p class="font-serif text-xl sm:text-2xl leading-snug text-white/90 max-w-xl mx-auto mb-10">
          {lang === 'es'
            ? 'Empieza con una valoración inicial online: 75-80 minutos para entender qué le pasa a tu cuerpo y por dónde empezar.'
            : 'Start with an online initial assessment: 75-80 minutes to understand what is happening in your body and where to begin.'}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={getLocalizedPath('/pricing', lang)}
            class="inline-flex items-center justify-center gap-2 bg-white text-brand-accent px-8 py-3.5 font-serif text-xl font-medium rounded-full hover:bg-brand-cream transition-colors"
          >
            <span>{lang === 'es' ? 'Reserva tu consulta' : 'Book your consultation'}</span>
          </a>
          <a
            href={getLocalizedPath('/contact', lang)}
            class="inline-flex items-center justify-center gap-2 border border-white/40 text-white px-8 py-3.5 font-serif text-xl font-medium rounded-full hover:bg-white/10 transition-colors"
          >
            <span>{t('cta.button')}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
