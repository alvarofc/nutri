---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="bg-brand-cream pt-24 sm:pt-36 pb-24 sm:pb-36 overflow-hidden">
  <!-- Message first -->
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
    <span class="block max-w-3xl mx-auto lg:mx-0 lg:max-w-none lg:w-max lg:relative lg:left-1/2 lg:-translate-x-1/2 lg:whitespace-nowrap text-sm sm:text-base font-semibold uppercase tracking-[0.16em] leading-relaxed text-brand-accent mb-8">
      {lang === 'es'
        ? 'Dietista-Nutricionista integrativa y especialista en salud hormonal'
        : 'Integrative Dietitian-Nutritionist and hormonal health specialist'}
    </span>

    <h2 class="text-3xl sm:text-4xl lg:text-[clamp(1.75rem,3.2vw,3rem)] italic leading-[1.15] text-brand-black max-w-4xl mx-auto lg:mx-0 lg:max-w-none lg:w-max lg:relative lg:left-1/2 lg:-translate-x-1/2 lg:whitespace-nowrap">
      {lang === 'es'
        ? '“Considero que una buena relación con la comida es clave para ser feliz”'
        : '“I believe a good relationship with food is key to being happy”'}
    </h2>
  </div>

  <!-- Smaller photo over a tinted band, with the section title set large behind it -->
  <div
    class="relative mt-16 sm:mt-20 pt-[calc(var(--about-title)*0.52)]"
    style="--about-title: clamp(3.5rem, 11vw, 9rem)"
  >
    <div class="absolute inset-x-0 top-0 bottom-[16%] bg-[#E5D3C8]"></div>

    <span
      aria-hidden="true"
      class="absolute inset-x-0 top-0 text-center uppercase whitespace-nowrap leading-[0.9] text-white select-none"
      style="font-size: var(--about-title); font-family: 'Cormorant', serif; font-weight: 300; letter-spacing: -0.02em"
    >
      {t('about.section.title')}
    </span>

    <div class="relative z-10 mx-auto w-[min(62vw,16.5rem)] aspect-square overflow-hidden rounded-2xl">
      <img
        src="/assets/sobre-mi.jpg"
        alt="Alexandra Ivanova"
        class="w-full h-full object-cover"
      />
    </div>
  </div>

  <!-- Text -->
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 pt-14 sm:pt-16 text-center">
    <p class="text-brand-gray text-lg leading-relaxed max-w-3xl mx-auto mb-10">
      {t('about.section.description')}
    </p>

    <a
      href={getLocalizedPath('/about', lang)}
      class="inline-flex items-center gap-2 text-brand-accent font-medium hover:gap-3 transition-all"
    >
      <span>{t('about.section.cta')}</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </a>
  </div>
</section>
