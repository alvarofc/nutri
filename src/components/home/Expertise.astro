---
import { Check } from 'lucide-astro';
import { getLangFromUrl, getLocalizedPath } from '../../i18n/ui';
import SectionHeader from '../layout/SectionHeader.astro';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';

const cards = [
  {
    anchor: 'tratamiento-digestivo',
    title: es ? 'Tu digestión te condiciona' : 'Your digestion holds you back',
    items: es
      ? [
          'Sientes que tu digestión condiciona tu día a día',
          'Digestiones pesadas, hinchazón y gases',
          'Acidez, estreñimiento o diarrea',
          'Esa sensación de que «todo me sienta mal»',
        ]
      : [
          'You feel your digestion shapes your whole day',
          'Heavy digestion, bloating and gas',
          'Heartburn, constipation or diarrhoea',
          'That feeling that “everything upsets me”',
        ],
    help: es
      ? 'Tus síntomas tienen una causa. La buscamos juntas y trabajamos desde la raíz.\nSin parches.'
      : 'Your symptoms have a cause. We look for it together and work from the root.\nNo quick fixes.',
  },
  {
    title: es ? 'Tus ciclos y tus hormonas' : 'Your cycle and your hormones',
    items: es
      ? [
          'Convives con reglas dolorosas o síndrome premenstrual',
          'SOP, endometriosis o adenomiosis',
          'Hipotiroidismo u otra alteración hormonal',
          'Quieres acompañar tu cuerpo desde la nutrición',
        ]
      : [
          'You live with painful periods or PMS',
          'PCOS, endometriosis or adenomyosis',
          'Hypothyroidism or another hormonal imbalance',
          'You want to support your body through nutrition',
        ],
    help: es
      ? 'Te explico cómo se relacionan tu alimentación, tu intestino y tus hormonas, y acompañamos tu tratamiento médico desde la nutrición.'
      : 'I explain how your diet, your gut and your hormones are connected, and we support your medical treatment through nutrition.',
  },
  {
    title: es ? 'Tu cuerpo ya no es el de antes' : 'Your body is not what it used to be',
    items: es
      ? [
          'Estás en perimenopausia o menopausia',
          'Notas peor sueño y más cansancio',
          'Más hinchazón y antojos',
          'Cambios en tu cuerpo',
          'Has escuchado que la alimentación influye muchísimo',
        ]
      : [
          'You are in perimenopause or menopause',
          'You notice poorer sleep and more tiredness',
          'More bloating and cravings',
          'Changes in your body',
          'You’ve heard that food makes a huge difference',
        ],
    help: es
      ? 'Te ayudo a entender qué está cambiando y a cuidar tu energía, tu descanso y tu cuerpo con la alimentación.'
      : 'I help you understand what is changing and look after your energy, rest and body through food.',
  },
  {
    title: es ? 'Tu analítica ha salido alterada' : 'Your blood tests came back off',
    items: es
      ? [
          'En tu última analítica ha aparecido algún parámetro alterado',
          'Glucosa, colesterol, hierro o hígado graso',
          'Te han dicho que «comas mejor»',
          'Pero nadie te ha explicado cómo hacerlo de una forma realista',
        ]
      : [
          'Your latest blood test shows an altered value',
          'Glucose, cholesterol, iron or fatty liver',
          'You’ve been told to “eat better”',
          'But nobody has explained how to do it realistically',
        ],
    help: es
      ? 'Te explico qué significan tus resultados y los convertimos en un plan realista, coordinado con tu médico.'
      : 'I explain what your results mean and we turn them into a realistic plan, coordinated with your doctor.',
  },
  {
    title: es ? 'Comer te genera estrés' : 'Eating stresses you out',
    items: es
      ? [
          'Quieres mejorar tu relación con la comida',
          'Comes por estrés o ansiedad',
          'Sientes culpa después de comer',
          'Quieres perder peso o mejorar tu composición corporal sin restricciones, dietas ni culpa',
        ]
      : [
          'You want a better relationship with food',
          'You eat when stressed or anxious',
          'You feel guilty after eating',
          'You want to lose weight or improve your body composition without restriction, diets or guilt',
        ],
    help: es
      ? 'Puedo acompañarte para adquirir una alimentación más tranquila, consciente y flexible. Una alimentación que realmente disfrutes.'
      : 'I can support you towards calmer, more mindful and flexible eating. Eating you truly enjoy.',
  },
  {
    title: es ? 'Quieres cuidarte, pero no llegas a todo' : 'You want to look after yourself, but you can’t do it all',
    items: es
      ? [
          'Sabes que quieres cuidarte, pero no tienes tiempo',
          'Llegas cansada e improvisas comidas',
          'Picas más de lo que te gustaría',
          'Sientes que no tienes tiempo para organizarte',
        ]
      : [
          'You know you want to look after yourself, but you have no time',
          'You get home tired and improvise meals',
          'You snack more than you’d like',
          'You feel you have no time to get organised',
        ],
    help: es
      ? 'Te ayudo a crear soluciones sencillas, prácticas y realistas.'
      : 'I help you create simple, practical and realistic solutions.',
  },
  {
    title: es ? 'Tu embarazo y tu posparto' : 'Your pregnancy and postpartum',
    items: es
      ? ['Estás en búsqueda de embarazo', 'Estás embarazada o dando el pecho', 'Estás en el posparto']
      : ['You are trying to conceive', 'You are pregnant or breastfeeding', 'You are in the postpartum period'],
    help: es
      ? 'Quieres acompañar tu cuerpo con una nutrición adaptada a esta etapa.'
      : 'You want to support your body with nutrition adapted to this stage.',
  },
];

// One short line per situation, shown on the front of the glass cards
const summaries = es
  ? [
      'Hinchazón, gases, digestiones pesadas, acidez, estreñimiento, diarrea o esa sensación de que “todo me sienta mal”.',
      'Convives con reglas dolorosas, síndrome del ovario poliquístico, endometriosis, hipo o hipertiroidismo, síndrome premenstrual u otra alteración hormonal y quieres acompañar tu cuerpo desde la nutrición integrativa.',
      'Estás en perimenopausia o menopausia y notas peor sueño, más cansancio, más hinchazón y antojos o cambios en tu cuerpo.',
      'En tu última analítica ha aparecido algún parámetro alterado, como glucosa, colesterol, hierro o hígado graso, y nadie te ha explicado cómo mejorarlo.',
      'Comes por estrés o ansiedad, sientes culpa después de comer y quieres mejorar tu relación con la comida, sin restricciones ni dietas.',
      'Quieres cuidarte, pero no tienes tiempo: llegas cansada, improvisas comidas y picas más de lo que te gustaría.',
      'Estás en búsqueda de embarazo, embarazada, dando el pecho o en el posparto.',
    ]
  : [
      'Bloating, gas, heavy digestion, heartburn, constipation, diarrhoea or that feeling that “everything upsets me”.',
      'You live with painful periods, polycystic ovary syndrome, endometriosis, hypo- or hyperthyroidism, premenstrual syndrome or another hormonal imbalance, and you want to support your body through integrative nutrition.',
      'You are in perimenopause or menopause and notice poorer sleep, more tiredness, more bloating and cravings or changes in your body.',
      'Your latest blood test shows an altered value, such as glucose, cholesterol, iron or fatty liver, and nobody has explained how to improve it.',
      'You eat when stressed or anxious, feel guilty after eating and want a better relationship with food, without restriction or diets.',
      'You want to look after yourself but have no time: you get home tired, improvise meals and snack more than you would like.',
      'You are trying to conceive, pregnant, breastfeeding or in the postpartum period.',
    ];

---

<section id="que-te-trae" class="scroll-mt-[4.5rem] relative overflow-hidden bg-[#E4D3D3] [&_.sec-title]:!max-w-none lg:[&_.sec-title]:whitespace-nowrap py-16 sm:py-24 [&_.lead]:text-[#2F1B24] lg:[&_.lead]:!max-w-none lg:[&_.lead]:!whitespace-nowrap [&_.text-brand-gray]:text-[#2F1B24]">
  <!-- Out-of-focus flower, tilted, in the bottom-right corner; multiplied onto the wall so it takes its colour and fades on its inner sides -->
  <div
    class="pointer-events-none absolute -bottom-[9%] -right-[3%] aspect-[756/839] w-[clamp(15rem,36%,28rem)] bg-cover mix-blend-multiply opacity-80 blur-[2px]"
    style="background-image: url('/assets/flor-esquina-6.jpg'); -webkit-mask-image: radial-gradient(ellipse 62% 62% at 64% 64%, #000 0%, rgba(0,0,0,.82) 18%, rgba(0,0,0,.55) 38%, rgba(0,0,0,.28) 58%, rgba(0,0,0,.1) 78%, transparent 100%); mask-image: radial-gradient(ellipse 62% 62% at 64% 64%, #000 0%, rgba(0,0,0,.82) 18%, rgba(0,0,0,.55) 38%, rgba(0,0,0,.28) 58%, rgba(0,0,0,.1) 78%, transparent 100%);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div>
      <!-- Section Header -->
      <SectionHeader
        eyebrow={es ? 'Cómo puedo ayudarte' : 'How I can help'}
        title={es ? '¿Te reconoces en alguna de estas situaciones?' : 'Do you recognise yourself in any of these situations?'}
        lead={es
          ? 'Te explico qué puede estar pasando y por dónde empezar.'
          : 'I’ll explain what may be going on and where to start.'}
      />

      <!-- Problem cards: frosted glass, flip on hover / focus / tap -->
      <div class="grid auto-rows-fr grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
        {[0, 1, 2, 6, 3, 4, 5].map((index) => { const card = cards[index]; return (
          <div class="flip cursor-pointer" tabindex="0" data-flip data-href={`${getLocalizedPath('/pricing', lang)}#${card.anchor ?? 'como-puedo-ayudarte'}`}>
            <div class="flip-inner">
              <!-- Front -->
              <div class="flip-face flip-front flex flex-col p-4 sm:p-5 rounded-2xl border border-white bg-[rgba(250,249,247,0.74)] shadow-[0_10px_30px_-18px_rgba(74,29,51,0.45)]">
                <h3 class="mb-3 text-[0.82rem] font-semibold uppercase leading-snug tracking-[0.06em] text-brand-accent" style="font-family: 'Montserrat', sans-serif !important; letter-spacing: 0.06em !important;">
                  {card.title}
                </h3>
                <p class="text-justify [hyphens:none] font-sans text-[15px] leading-snug text-brand-gray">{summaries[index]}</p>
              </div>

              <!-- Back -->
              <div class="flip-face flip-back flex flex-col items-start justify-center gap-3 rounded-2xl p-4 sm:p-5">
                <p class="flip-help text-justify [hyphens:none] font-sans text-[15px] leading-snug text-[#F3E6E1]">{card.help.split('\n').map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}</p>
              </div>
            </div>
          </div>
        ); })}

        <!-- 8th card: empty for now, same glass style as the others -->
        <div class="min-h-[9rem] rounded-2xl border border-white bg-[rgba(250,249,247,0.74)] p-4 shadow-[0_10px_30px_-18px_rgba(74,29,51,0.45)] sm:p-5" aria-hidden="true"></div>
      </div>

      <!-- Link to the new "How can I help you?" room on the services page -->
      <div class="mt-12 text-center">
        <a href={`${getLocalizedPath('/pricing', lang)}#como-puedo-ayudarte`} class="eyebrow eyebrow-link">
          <span>{es ? 'Saber más' : 'Learn more'}</span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .flip {
    perspective: 1200px;
    outline: none;
    height: 100%;
  }
  .flip-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.4, 0.2, 0.2, 1);
  }
  /* Both faces share the same grid cell, so the card is as tall as the taller face */
  .flip-face {
    grid-area: 1 / 1;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip-face {
    min-height: 9rem;
  }
  .flip-back {
    transform: rotateY(180deg);
    background: rgba(91, 31, 46, 0.93);
    border: 1px solid rgba(255, 255, 255, 0.85);
  }
  .flip:hover .flip-inner,
  .flip:focus-within .flip-inner,
  .flip.is-flipped .flip-inner {
    transform: rotateY(180deg);
  }
  .flip:focus-visible .flip-face:not(.flip-back) {
    box-shadow: 0 0 0 2px rgba(74, 29, 51, 0.35);
  }
  @media (prefers-reduced-motion: reduce) {
    .flip-inner {
      transition: none;
    }
  }

  /* Phones: no flip. Each card shows the situation and, right below, how I help */
  @media (max-width: 767px) {
    .flip-inner {
      display: block;
      transform: none !important;
      transition: none;
    }
    .flip-face {
      min-height: 0;
      backface-visibility: visible;
      -webkit-backface-visibility: visible;
    }
    .flip-front {
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
      border-bottom: 0;
      padding-bottom: 0.5rem;
      box-shadow: none;
    }
    .flip-back {
      transform: none;
      align-items: flex-start;
      justify-content: flex-start;
      background: rgba(250, 249, 247, 0.74);
      border: 1px solid #fff;
      border-top: 0;
      border-top-left-radius: 0;
      border-top-right-radius: 0;
      padding-top: 0;
      box-shadow: 0 10px 30px -18px rgba(74, 29, 51, 0.45);
    }
    .flip-back .flip-help {
      color: #4A1D33;
      font-weight: 400;
      border-top: 1px solid rgba(91, 31, 46, 0.18);
      padding-top: 0.75rem;
    }
    .flip-back .flip-link {
      color: #79264D !important;
    }
  }
</style>

<script>
  // A card with a destination goes there when clicked; on touch screens the others flip when tapped.
  const touch = window.matchMedia('(hover: none)').matches;
  document.querySelectorAll<HTMLElement>('[data-flip]').forEach((card) => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      const href = card.dataset.href;
      if (href) {
        window.location.href = href;
      } else if (touch) {
        card.classList.toggle('is-flipped');
      }
    });
  });

  // The text never leaves its card: when the card is too narrow, the type shrinks just enough to fit
  // (all cards share the same size for each kind of text, so they stay consistent).
  const fitCardText = () => {
    const roles = ['.flip-front h3', '.flip-front p', '.flip-help'];
    roles.forEach((sel) => {
      const els = Array.from(document.querySelectorAll<HTMLElement>(`#que-te-trae ${sel}`));
      els.forEach((el) => (el.style.fontSize = ''));
      const base = parseFloat(getComputedStyle(els[0]).fontSize);
      let size = base;
      const overflows = () => els.some((el) => el.scrollWidth > el.clientWidth + 0.5);
      while (overflows() && size > 9) {
        size -= 0.25;
        els.forEach((el) => (el.style.fontSize = `${size}px`));
      }
    });
  };
  let fitTimer: number;
  const scheduleFit = () => {
    window.clearTimeout(fitTimer);
    fitTimer = window.setTimeout(fitCardText, 80);
  };
  window.addEventListener('resize', scheduleFit);
  document.fonts.ready.then(fitCardText);
  fitCardText();
</script>
