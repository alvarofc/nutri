---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/ui';
import Logo from './Logo.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const es = lang === 'es';

const navLinks = [
  { name: t('nav.pricing'), href: getLocalizedPath('/pricing', lang) },
  { name: t('nav.about'), href: getLocalizedPath('/about', lang) },
  { name: t('nav.contact'), href: getLocalizedPath('/contact', lang) },
  { name: t('nav.blog'), href: getLocalizedPath('/blog', lang) },
];

const instagram = 'https://www.instagram.com/tunutrialexandra/';
const linkClass = 'text-sm text-brand-gray transition-colors hover:text-brand-accent';
const headingClass = 'mb-5 text-xs font-medium uppercase tracking-[0.2em] text-brand-accent';
---

<footer class="border-t border-brand-accent/15 bg-brand-cream" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">{t('footer.heading')}</h2>

  <!-- Four equal columns, same top line, same left edge inside each one -->
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 lg:grid-cols-4 lg:gap-x-12">

      <!-- Brand -->
      <div class="col-span-2 lg:col-span-1">
        <Logo />
      </div>

      <!-- Navigation -->
      <div>
        <h3 class={headingClass}>{es ? 'Navegación' : 'Navigate'}</h3>
        <ul class="space-y-3">
          {navLinks.map((link) => (
            <li><a href={link.href} class={linkClass}>{link.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class={headingClass}>{t('contact.title')}</h3>
        <ul class="space-y-3">
          <li><a href={`mailto:${t('contact.email.address')}`} class={`${linkClass} break-all`}>{t('contact.email.address')}</a></li>
          <li class="text-sm text-brand-gray">{t('contact.phone.number')}</li>
          <li><a href={instagram} target="_blank" rel="noopener noreferrer" class={linkClass}>Instagram</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class={headingClass}>{t('footer.legal')}</h3>
        <ul class="space-y-3">
          <li><a href={getLocalizedPath('/privacy', lang)} class={linkClass}>{t('footer.privacy')}</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar: copyright on the left, registration on the right, on the same baseline -->
  <div class="border-t border-brand-accent/15">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-5 text-xs text-brand-gray sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
      <p>© {new Date().getFullYear()} Alexandra Ivanova. {t('footer.rights')}</p>
      <p>MAD01541 · {es ? 'Dietista-Nutricionista colegiada' : 'Registered Dietitian-Nutritionist'}</p>
    </div>
  </div>
</footer>
