---
import { getLangFromUrl, useTranslations, getLocalizedPath, languages } from '../../i18n/ui';
import Logo from './Logo.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  {
    name: t('nav.pricing'),
    href: getLocalizedPath('/pricing', lang),
  },
  {
    name: t('nav.about'),
    href: getLocalizedPath('/about', lang),
  },
  {
    name: t('nav.contact'),
    href: getLocalizedPath('/contact', lang),
  },
  {
    name: t('nav.blog'),
    href: getLocalizedPath('/blog', lang),
  },
];

const bookingPath = getLocalizedPath('/booking', lang);

// The page you are on gets underlined (the home page does not)
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => here === href || here.startsWith(href + '/');
---

<header
  x-data="{ open: false }"
  class="fixed top-0 left-0 right-0 z-50 bg-[rgba(255,255,255,0.75)] backdrop-blur-md border-b border-brand-black/5"
  role="banner"
  itemscope
  itemtype="https://schema.org/WPHeader"
>
  <div class="mx-auto max-w-7xl">
    <div class="flex items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
      <!-- Left: Logo -->
      <Logo />

      <!-- Right: links, "Pide cita" and the language switcher (Desktop) -->
      <div class="hidden lg:flex items-center gap-8">
        <nav class="flex items-center gap-8" aria-label={t('header.navigation.aria')}>
          {links.map((link) => (
            <a
              href={link.href}
              class={`font-sans text-[0.85rem] font-medium uppercase tracking-[0.06em] text-brand-black/80 hover:text-brand-accent transition-colors underline-offset-[10px] decoration-1 ${isActive(link.href) ? 'underline text-brand-black' : ''}`}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.name}
            </a>
          ))}
          <a
            href={bookingPath}
            class="nav-cta"
            aria-current={isActive(bookingPath) ? 'page' : undefined}
          >
            <span>{t('nav.booking')}</span>
            <svg class="nav-cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </nav>

        <!-- Language Switcher: one above the other -->
        <div class="ml-5 flex flex-col items-center gap-0.5 leading-none">
          {Object.entries(languages).map(([code, name]) => (
            <a
              href={getLocalizedPath(Astro.url.pathname, code as keyof typeof languages)}
              class={`text-xs font-medium uppercase tracking-wide transition-colors ${
                lang === code
                  ? 'text-brand-black'
                  : 'text-brand-muted hover:text-brand-black'
              }`}
              aria-current={lang === code ? 'page' : undefined}
              data-lang-preference={code}
            >
              {code}
            </a>
          ))}
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 text-brand-black"
        @click="open = !open"
        aria-controls="mobile-menu"
        :aria-expanded="open.toString()"
      >
        <span class="sr-only">{t('header.toggle.menu')}</span>
        <svg
          x-show="!open"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg
          x-show="open"
          x-cloak
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    x-show="open"
    x-cloak
    x-collapse
    class="lg:hidden bg-white border-t border-brand-black/5"
  >
    <nav class="flex flex-col px-6 py-8 gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          class={`font-sans text-xl font-medium text-brand-black hover:text-brand-accent transition-colors underline-offset-8 ${isActive(link.href) ? 'underline' : ''}`}
        >
          {link.name}
        </a>
      ))}
      
      <!-- Mobile Language Switcher -->
      <div class="flex items-center gap-4 pt-6 border-t border-brand-black/10">
        {Object.entries(languages).map(([code, name]) => (
          <a
            href={getLocalizedPath(Astro.url.pathname, code as keyof typeof languages)}
            class={`text-sm font-medium ${
              lang === code ? 'text-brand-black' : 'text-brand-muted'
            }`}
            data-lang-preference={code}
          >
            {name}
          </a>
        ))}
      </div>

      <!-- Mobile CTA -->
      <a
        href={bookingPath}
        class="cta-gradient-btn relative overflow-hidden mt-4 bg-brand-accent text-white px-6 py-4 text-center font-medium rounded-full transition-all duration-300"
      >
        <span class="relative z-10">{t('nav.booking')}</span>
      </a>
    </nav>
  </div>
</header>

<style>
  /* "Pide cita": bold text that turns into a round pill with an arrow on hover */
  .nav-cta {
    position: relative; display: inline-flex; align-items: center; border-radius: 9999px;
    padding: 0.55rem 1.25rem; margin-inline: -1.25rem -1.25rem;
    font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #222;
    transition: background-color 0.3s ease, color 0.3s ease, padding 0.3s ease, margin 0.3s ease;
  }
  .nav-cta-arrow { position: absolute; right: 1.1rem; height: 1rem; width: 1rem; opacity: 0; transform: translateX(-6px); transition: opacity 0.3s ease, transform 0.3s ease; }
  .nav-cta:hover, .nav-cta:focus-visible { background: #79264D; color: #fff; padding-right: 2.7rem; margin-right: -2.7rem; outline: none; }
  .nav-cta:hover .nav-cta-arrow, .nav-cta:focus-visible .nav-cta-arrow { opacity: 1; transform: none; }
</style>

<!-- Spacer for fixed header -->
<div class="h-[72px]"></div>
