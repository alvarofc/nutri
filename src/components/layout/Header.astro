---
import { getLangFromUrl, useTranslations, getLocalizedPath, languages } from '../../i18n/ui';
import Logo from './Logo.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  {
    name: t('nav.pricing'),
    href: getLocalizedPath('/pricing', lang),
  },
  {
    name: t('nav.about'),
    href: getLocalizedPath('/about', lang),
  },
  {
    name: t('nav.contact'),
    href: getLocalizedPath('/contact', lang),
  },
  {
    name: t('nav.blog'),
    href: getLocalizedPath('/blog', lang),
  },
];

const bookingPath = getLocalizedPath('/booking', lang);
const homePath = getLocalizedPath('/', lang);

// The page you are on is shown in the accent colour (no underlines in the bar)
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => here === href || here.startsWith(href + '/');
const isHome = here === (homePath.replace(/\/$/, '') || '/');
---

<header
  x-data="{ open: false }"
  @keydown.escape.window="open = false"
  class="site-header fixed top-0 left-0 right-0 z-50 bg-[rgba(255,255,255,0.75)] backdrop-blur-md border-b border-brand-black/5"
  role="banner"
  itemscope
  itemtype="https://schema.org/WPHeader"
>
  <div class="mx-auto max-w-7xl">
    <div class="flex items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
      <!-- Left: Logo -->
      <Logo />

      <!-- Right: links, "Pide cita" and the language switcher (Desktop) -->
      <div class="hidden lg:flex items-center gap-8">
        <nav class="flex items-center gap-8" aria-label={t('header.navigation.aria')}>
          {links.map((link) => (
            <a
              href={link.href}
              class={`font-sans text-[0.85rem] font-medium uppercase tracking-[0.06em] text-brand-black/80 hover:text-brand-accent transition-colors ${isActive(link.href) ? '!text-brand-accent' : ''}`}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.name}
            </a>
          ))}
          <a
            href={bookingPath}
            class="nav-cta"
            aria-current={isActive(bookingPath) ? 'page' : undefined}
          >
            <span>{t('nav.booking')}</span>
            <svg class="nav-cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </nav>

        <!-- Language Switcher: one above the other -->
        <div class="ml-5 flex flex-col items-center gap-0.5 leading-none">
          {Object.entries(languages).map(([code, name]) => (
            <a
              href={getLocalizedPath(Astro.url.pathname, code as keyof typeof languages)}
              class={`text-xs font-medium uppercase tracking-wide transition-colors ${
                lang === code
                  ? 'text-brand-black'
                  : 'text-brand-muted hover:text-brand-black'
              }`}
              aria-current={lang === code ? 'page' : undefined}
              data-lang-preference={code}
            >
              {code}
            </a>
          ))}
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="lg:hidden inline-flex h-11 w-11 items-center justify-center rounded-full border border-brand-black/25 bg-white/45 text-brand-black backdrop-blur-sm transition-colors hover:bg-white/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
        @click="open = !open"
        aria-controls="mobile-menu"
        :aria-expanded="open.toString()"
      >
        <span class="sr-only">{t('header.toggle.menu')}</span>
        <svg
          x-show="!open"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg
          x-show="open"
          x-cloak
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    x-show="open"
    x-cloak
    x-transition.opacity.duration.200ms
    class="mobile-panel absolute left-4 right-4 top-full mt-2 overflow-hidden rounded-[1.6rem] sm:left-6 sm:right-6 lg:hidden"
  >
    <nav class="flex flex-col items-center gap-4 px-6 py-7 text-center sm:gap-5 sm:py-8" aria-label={t('header.navigation.aria')}>
      <a
        href={homePath}
        aria-current={isHome ? 'page' : undefined}
        @click="open = false"
        class={`font-sans text-base font-medium uppercase tracking-[0.1em] text-brand-black/75 transition-colors hover:text-brand-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent sm:text-lg ${isHome ? '!font-semibold !text-brand-black' : ''}`}
      >
        {lang === 'es' ? 'Inicio' : 'Home'}
      </a>

      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          @click="open = false"
          class={`font-sans text-base font-medium uppercase tracking-[0.1em] text-brand-black/75 transition-colors hover:text-brand-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent sm:text-lg ${isActive(link.href) ? '!font-semibold !text-brand-black' : ''}`}
        >
          {link.name}
        </a>
      ))}

      <a
        href={bookingPath}
        aria-current={isActive(bookingPath) ? 'page' : undefined}
        @click="open = false"
        class="mt-1 font-sans text-base font-bold uppercase tracking-[0.1em] text-brand-black transition-colors hover:text-brand-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent sm:text-lg"
      >
        {t('nav.booking')}
      </a>

      <!-- Mobile Language Switcher -->
      <div class="mt-2 flex items-center justify-center gap-5 border-t border-brand-black/15 pt-4">
        {Object.entries(languages).map(([code]) => (
          <a
            href={getLocalizedPath(Astro.url.pathname, code as keyof typeof languages)}
            class={`text-xs font-medium uppercase tracking-[0.12em] transition-colors ${lang === code ? 'text-brand-black' : 'text-brand-black/50 hover:text-brand-black'}`}
            data-lang-preference={code}
            @click="open = false"
          >
            {code}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<style>
  /* Phones and tablets: cream translucent bar with rounded bottom corners, always at the top; the menu is a floating cream card */
  @media (max-width: 1023px) {
    .site-header {
      background: rgba(255, 255, 255, 0.75);
      -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
      border-bottom: 0; border-radius: 0 0 1.6rem 1.6rem;
    }
  }
  .mobile-panel {
    background: rgba(250, 249, 247, 0.94);
    border: 1px solid rgba(34, 34, 34, 0.06);
    -webkit-backdrop-filter: blur(28px); backdrop-filter: blur(28px);
    box-shadow: 0 24px 50px -24px rgba(34, 34, 34, 0.3);
  }
  /* "Pide cita": bold text that turns into a round pill with an arrow on hover */
  .nav-cta {
    position: relative; display: inline-flex; align-items: center; border-radius: 9999px;
    padding: 0.55rem 1.25rem; margin-inline: -1.25rem -1.25rem;
    font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(34, 34, 34, 0.8);
    transition: background-color 0.3s ease, color 0.3s ease, padding 0.3s ease, margin 0.3s ease;
  }
  .nav-cta-arrow { position: absolute; right: 1.1rem; height: 1rem; width: 1rem; opacity: 0; transform: translateX(-6px); transition: opacity 0.3s ease, transform 0.3s ease; }
  .nav-cta:hover, .nav-cta:focus-visible { background: #79264D; color: #fff; padding-right: 2.7rem; margin-right: -2.7rem; outline: none; }
  .nav-cta:hover .nav-cta-arrow, .nav-cta:focus-visible .nav-cta-arrow { opacity: 1; transform: none; }
</style>

<!-- Spacer for fixed header -->
<div class="h-[72px]"></div>
